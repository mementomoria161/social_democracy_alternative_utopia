title: Status
new-page: true
is-special: true
on-arrival: {!
// German decimal comma; 0 must be shown too (it is falsy)
var de1 = function(x) { return (+x || 0).toFixed(1).replace('.', ',').replace('-', '−'); };
Q.unemployed_2 = de1(Q.unemployed);
Q.inflation_2 = de1(Q.inflation);
Q.cl_status_text = ['nicht auf Kurs', 'Ziel 2030 in Reichweite, Paris verfehlt', 'auf Paris-Kurs'][Q.cl_status || 0];
Q.cl_ee_i = Math.round(Q.cl_ee || 0);
Q.economic_growth_2 = de1(Q.economic_growth);
// eigenes Profil als Juniorpartner (post_event: ab 3 entfällt der Zusatzverlust)
var pf = Q.profil || 0;
Q.profil_text = pf < 1 ? 'kaum erkennbar' : pf < 2 ? 'schwach' : pf < 3 ? 'erkennbar' : 'klar';
!}

= Status

[+ month : month +] [+ year +]

# Lagebeschreibung, früher als Text über der Hand (main.scene.dry)
[? if year = 2024 and month = 11 : Die Ampel ist Geschichte. Bis zur Neuwahl regieren SPD und Grüne ohne eigene Mehrheit. ?]

Verfügbare Ressourcen: [+ resources +]

Rolle [+ pp_dat +]: [? if spd_toleration : Tolerierung ?][? if spd_in_government : Regierung – ?][? if spd_toleration == 0 and spd_in_government == 0 and spd_caretaker == 0 : Opposition ?][? if spd_caretaker : geschäftsführende Regierung ?]
[? if spd_in_government or spd_toleration : [+ coalition_name +] ?]

[? if spd_in_government and not in_spd_majority and not in_left_front : Koalitionskonflikte: [+ coalition_dissent : coalition_dissent +] ?]

[? if spd_in_government and chancellor_party != "SPD" : Eigenes Profil in der Regierung: [+ profil_text +] ?]

[? if spd_in_government and (in_left_front or in_popular_front): Konflikte mit [+ op_dat +]: [+ linke_coalition_dissent : coalition_dissent +] ?]

Innerparteilicher Unmut: [+ dissent_percent : dissent +]

[? if spd_in_government = 1 : Haushaltsspielraum: [+ budget +] ?]

Migration als wichtiges Problem: [+ mig_sal +] % der Befragten

Nächste Bundestagswahl: [? if election_scheduled : [+ next_election_month : month +] [+ next_election_year +] ?][? if not election_scheduled : noch nicht terminiert (regulär [+ next_election_month : month +] [+ next_election_year +]) ?]

= Wirtschaft

Inflation: [+ inflation_2 +] %

Arbeitslosenquote: [+ unemployed_2 +] %

Wirtschaftswachstum: [+ economic_growth_2 +] %

= Klima

Treibhausgase: [+ cl_total_i +] Mio. t im Jahr (Ziel 2030: 438)

Erneuerbare am Strom: [+ cl_ee_i +] %

Klimakurs: [+ cl_status_text +]

