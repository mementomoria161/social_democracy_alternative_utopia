}
if (Q.bauern_strength) {
    Q.bauern_strength_2 = Q.bauern_strength.toFixed(0);
}
if (Q.rechts_strength) {
    Q.rechts_strength_2 = Q.rechts_strength.toFixed(0);
}
!}

