@government
on-display: {!
if (!Q.parties || typeof document === 'undefined') return;
var P = {
    linke: [Q.op_name || 'Linke', Q.op_color || '#BE3075'], sapd: ['Soziale Linke', '#C40000'], spd: [Q.pp_name || 'SPD', Q.pp_color || '#E3000F'],
    srpd: ['Neue Mitte', '#F4A460'], gruene: [Q.gruene_name || 'Grüne', '#46962B'], other: ['Sonstige', '#909090'],
    bsw: ['BSW', '#7D254F'], fdp: ['FDP', '#FFED00'], union: ['CDU/CSU', '#151518'], afd: ['AfD', '#009EE0']
};
// party strings used in *_minister_party / chancellor_party
var ID = {'SPD': 'spd', 'Union': 'union', 'Grüne': 'gruene', 'Linke': 'linke', 'FDP': 'fdp', 'BSW': 'bsw', 'AfD': 'afd', 'Soziale Linke': 'sapd', 'Neue Mitte': 'srpd'};
var box = function(id) {
    var c = P[id] ? P[id][1] : 'transparent';
    return '<span class="box" style="background-color:' + c + '; outline: 1px solid var(--border-color);"></span> ';
};
var label = function(party) { return ID[party] ? P[ID[party]][0] : (party || ''); };
// photo file in img/portraits: umlauts transliterated, spaces as underscores
var file = function(name) {
    return String(name).replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/Ä/g, 'Ae')
        .replace(/Ö/g, 'Oe').replace(/Ü/g, 'Ue').replace(/ß/g, 'ss').replace(/ç/g, 'c').replace(/ı/g, 'i').replace(/ /g, '_');
};
// a person in the org chart: photo in a ring of the party colour, initial as fallback
var card = function(role, name, party, big) {
    var c = P[ID[party]] ? P[ID[party]][1] : '#909090';
    var img = name && name != 'N. N.' ? '<img src="img/portraits/' + file(name) + '.jpg" alt="" onerror="this.remove()">' : '';
    return '<div class="gov_card' + (big ? ' big' : '') + '"><div class="gov_photo" style="border-color:' + c + '; background-color:' + c + '">' +
        '<span>' + String(name || '?').charAt(0) + '</span>' + img + '</div><div class="gov_role">' + role + '</div>' +
        '<div class="gov_name">' + (name || '–') + '</div><div class="gov_party">' + label(party) + '</div></div>';
};
// real party of these persons; slot() turns it into the slot string (SPD and Linke swap when the Linke is played)
var slot = function(p) { return Q.player == 'linke' ? ({'SPD': 'Linke', 'Linke': 'SPD'}[p] || p) : p; };
var PERSON = {'Steinmeier': 'SPD', 'Aigner': 'Union', 'Berthold': 'AfD', 'Lammert': 'Union', 'Schwesig': 'SPD', 'Trabert': 'parteilos', 'Chrupalla': 'AfD',
    'Klöckner': 'Union', 'Ortleb': 'SPD', 'Nouripour': 'Grüne', 'Ramelow': 'Linke', 'Bas': 'SPD'};

// Kabinett (after the 2025 election the old government stays in office until the Kanzlerwahl: snapshot Q.gf_gov from events/bundestagswahl)
var gf = Q.gf_gov && !Q.kanzlerwahl_seen && Q.time < (Q.last_election_time || 0) + 4;
var G = gf ? Q.gf_gov : Q;
var posts = [['foreign', 'Auswärtiges'], ['interior', 'Inneres'], ['justice', 'Justiz'], ['labor', 'Arbeit und Soziales'],
    ['bundeswehr', 'Verteidigung'], ['economic', 'Wirtschaft'], ['finance', 'Finanzen'], ['agriculture', 'Landwirtschaft']];
var gov = {}, partners = {};
if (ID[G.chancellor_party]) gov[ID[G.chancellor_party]] = 1;
var cabinet = '';
for (var i = 0; i < posts.length; i++) {
    var party = G[posts[i][0] + '_minister_party'];
    if (ID[party]) gov[ID[party]] = (gov[ID[party]] || 0) + 1;
    if (ID[party] && party != G.chancellor_party) partners[party] = (partners[party] || 0) + 1;
    cabinet += card(posts[i][1], G[posts[i][0] + '_minister'], party);
}
// Vizekanzler*in: strongest partner in the cabinet, preferably from its most important ministry
var viceParty = Object.keys(partners).sort(function(a, b) { return partners[b] - partners[a]; })[0];
var vice = '';
['finance', 'economic', 'foreign', 'interior', 'labor', 'justice', 'bundeswehr', 'agriculture'].some(function(p) {
    if (!viceParty || G[p + '_minister_party'] != viceParty) return false;
    vice = card('Vizekanzler\*in', G[p + '_minister'], viceParty);
    return true;
});
var btp = Q.bundestag_president || 'Klöckner';
document.getElementById('regierung_view').innerHTML = (gf ? '<p class="poll_note">Bis zur Kanzlerwahl bleibt die Regierung ' + G.chancellor + ' geschäftsführend im Amt.' + (Q.coalition_name && Q.coalition_name != 'keine' && Q.coalition_name != 'geschäftsführende Regierung' ? ' Nach der Wahl verhandelt: ' + Q.coalition_name + '.' : '') + '</p>' : '') + '<div class="gov_chart">' +
    '<div class="gov_row">' + card('Bundespräsident\*in', Q.president, slot(PERSON[Q.president])) + card('Bundestagspräsident\*in', btp, slot(PERSON[btp])) + '</div>' +
    '<div class="gov_line"></div>' +
    '<div class="gov_row">' + card('Bundeskanzler\*in', G.chancellor, G.chancellor_party, true) + vice + '</div>' +
    '<div class="gov_line"></div>' +
    '<div class="gov_cabinet">' + cabinet + '</div></div>';

// Bundestag: 733 Sitze bis zur Wahl 2025 (20. Wahlperiode), danach 630; Verteilung nach größtem Rest
var seats = Q.bundestag_seats || 630;
var needed = Math.floor(seats / 2) + 1;
var order = ['linke', 'sapd', 'spd', 'srpd', 'gruene', 'other', 'bsw', 'fdp', 'union', 'afd'];
var rows = order.filter(function(p) { return Q[p + '_r'] > 0; }).map(function(p) { return {id: p, r: Q[p + '_r']}; });
var total = rows.reduce(function(s, x) { return s + x.r; }, 0);
rows.forEach(function(x) { x.exact = x.r / total * seats; x.seats = Math.floor(x.exact); });
var rest = seats - rows.reduce(function(s, x) { return s + x.seats; }, 0);
rows.slice().sort(function(a, b) { return (b.exact - b.seats) - (a.exact - a.seats); }).slice(0, rest).forEach(function(x) { x.seats++; });

var govSeats = 0;
var table = '<table class="gov_table">';
rows.forEach(function(x) {
    if (gov[x.id]) govSeats += x.seats;
    table += '<tr><td>' + box(x.id) + '</td><td>' + (gov[x.id] ? '<b>' + P[x.id][0] + '</b>' : P[x.id][0]) + '</td><td style="text-align:right">' + x.seats + '</td></tr>';
});
table += '</table>';
document.getElementById('bundestag_table').innerHTML = table +
    'Regierungsparteien (fett): <b>' + govSeats + '</b> von ' + seats + ' Sitzen, ' + (govSeats >= needed ? 'eigene Mehrheit' : 'keine eigene Mehrheit') + ' (' + needed + ' nötig).' +
    (seats != 630 ? ' „Sonstige“: fraktionslose Abgeordnete, darunter der SSW.' : '');

var width = document.getElementById('qualities').offsetWidth;
var svg = document.getElementById('bundestag_sidebar');
svg.style.width = width + 'px';
svg.style.height = width / 2 + 'px';
var parliament = d3.parliament();
parliament.width(width).height(width).innerRadiusCoef(0.4);
parliament.enter.fromCenter(false).smallToBig(false);
d3.select(svg).datum(rows.map(function(x) { return {id: x.id, legend: P[x.id][0], name: P[x.id][0], seats: x.seats}; })).call(parliament);
!}

