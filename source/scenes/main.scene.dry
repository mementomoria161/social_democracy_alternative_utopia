title: Nächster Monat
set-bg: img/map_2.jpg
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Berater – eine Aktion ist verfügbar.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Berater – nächste Aktion in 1 Monat verfügbar.';
} else {
    Q.pinnedCardsDescription = 'Berater – nächste Aktion in ' + Q.advisor_action_timer + ' Monaten verfügbar.';
}
!}
max-cards: 3

#Here, the main deck will be displayed. Clicking on the deck draws a card into your hand. Clicking on a card activates that card.

[? if year = 2026 and month = 1 : Die Koalition aus Union und SPD geht in ihr erstes volles Regierungsjahr. Die nächste Bundestagswahl ist für Anfang 2029 angesetzt. ?]

- @party
- @govt
- #advisor
- @shuffle_leadership_pinned

