title: Spielende.
new-page: true
go-to: eg_menu
on-arrival: {!
Q.game_over = 1;
// Achievements:
// Große Koalition - form a grand coalition
// Eiserne Front - Form the Iron Front.
this.achieve('game_completed');

// Roter Zar von Preußen - At the end of the game, Otto Braun is president, chancellor, and minister-president of prussia at the same time.
if (Q.player != 'linke' && Q.president == 'Schwesig' && Q.chancellor_party == 'SPD' && Q.spd_prussia) {
    this.achieve('red_tzar_of_prussia');
}
// Bürgerkrieg - enter a long civil war.
if (Q.long_war) {
    this.achieve('civil_war');
}
// Sieg für die Republik - victory for the republic
if (Q.republic_victory) {
    this.achieve('victory_for_the_republic');
}
// Einigkeit - survive on easy without a civil war.
// Einigkeit und Recht - survive on medium without a civil war.
// Einigkeit und Recht und Freiheit - survive on hard without a civil war.

// Einheitsfront - form a united front with the KPD, and win the civil war.

// Volksfront - form a popular front government, and win the civil war.

// Verfassungskoalition - form a Constitutional Coalition.
// Wirtschaftspolitik - enact an economic plan.
// Wirtschaftswunder - reduce unemployment below 10% and have a non-negative budget by 1933.
if (Q.year >= 2029  && Q.unemployed < 6.3 && Q.budget > 0 && Q.inflation < 5) {
    this.achieve('wirtschaftswunder');
}
// Bollwerk der Demokratie - resist the Prussian Coup, and win.
if (Q.republic_victory && Q.resist_coup) {
    this.achieve('bollwerk_der_demokratie');
}
// Der österreichische Gefreiter - deport hitler
// Volkspartei - form a people's party
// Hirschfeld - legalize 2 of homosexual rights and trans rights.
if (Q.homosexual_rights >= 2) {
    this.achieve('hirschfeld');
}
// Mädchen und Uniform - a woman's place is in the Reichsbanner.
// Gleichheit - Support and enact reforms for women's rights.
if ((Q.womens_work && Q.womens_rights >= 5) || (Q.abortion_rights && Q.womens_rights >= 3)) {
    this.achieve('equality');
}

// Sohn seiner Klasse - elect Ernst Thälmann as president or chancellor.
// slot string: the Linke is 'SPD' when it is the player party
if (Q.chancellor_party == (Q.player == 'linke' ? 'SPD' : 'Linke') || Q.president == "Trabert") {
    this.achieve('sohn_seiner_klasse');
}

// calculate normalized class voting for the achievements
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}

// Die Rote Fahne - join the KPD in the May Day march.
// Mehrheitspartei - form an SPD majority government in the Reichstag.
// Panik im Mittelstand - have over 50% of New Middle Class support.
if (Q.new_middle_spd_normalized && Q.new_middle_spd_normalized >= 50) {
    this.achieve('panik_im_mittelstand');
}
// Bauernrevolution - have over 50% rural support.
if (Q.rural_spd_normalized && Q.rural_spd_normalized >= 50) {
    this.achieve('bauernrevolution');
}
if (Q.rentner_spd_normalized && Q.rentner_spd_normalized >= 50) {
    this.achieve('katholischer_sozialismus');
}
if (Q.workers_spd_normalized >= 80 && Q.new_middle_spd_normalized <= 20 && Q.old_middle_spd_normalized <= 20 && Q.rural_spd_normalized <= 20) {
    this.achieve('klassenkampf');
}
if (Q.workers_spd_normalized >= 40 && Q.new_middle_spd_normalized >= 40 && Q.old_middle_spd_normalized >= 40 && Q.rural_spd_normalized >= 40) {
    this.achieve('grosse_volkspartei');
}
// Räterepublik - begin the transformation to a socialist economy.
if (Q.spd_in_government && ((Q.nationalization_progress >= 2 && Q.economic_democracy >= 3) || (Q.nationalization_progress >= 1 && Q.economic_democracy >= 4))) {
    this.achieve('raterepublik');
}
// Polykrise - survive both a fascist coup and a capital strike.
if (Q.march_on_berlin_seen && Q.capital_strike_seen && Q.chancellor_party != "AfD" && !Q.total_defeat) {
    this.achieve("polykrise");
}
// Wirtschaftsexperiment - implement two different economic plans.
if ((Q.nationalization_progress >= 1 && Q.wtb_implemented >= 1) || (Q.wtb_implemented >= 1 && Q.moderate_plan_progress >= 1) || (Q.nationalization_progress >= 1 && Q.moderate_plan_progress >= 1)) {
    this.achieve("wirtschaftsexperiment");
}
// Syndikalismus - support factory takeovers by workers.
if (Q.factory_takeovers >= 2) {
    this.achieve("syndikalismus");
}
// Stolperstein - lose the civil war against Hitler.
if ((Q.chancellor_party == "AfD" || Q.president == "Chrupalla") && Q.total_defeat) {
    this.achieve('stolperstein');
}
// Heidelberger Programm - fulfill the goals of the Heidelberg programm - increase welfare, reform justice, support women's rights, progressive taxation, works councils, build a European Union.
if ((Q.welfare > 0 && Q.judicial_reform >= 2 && Q.womens_work >= 1 && Q.family_law >= 1 && Q.upper_tax_rates > Q.lower_tax_rates && Q.works_councils > 0 && Q.eu > 0)) {
    this.achieve('heidelberger_programm');
}
!}

= Ende


@eg_menu

- #endings
- @end_game: Spiel beenden.


@hitler_wins
view-if: (chancellor_party == "AfD" or president == "Chrupalla") and (total_defeat==1 or civil_war_seen == 0)
title: Die AfD beherrscht Deutschland.
tags: endings
go-to: eg_menu

Die AfD hat die Macht in Deutschland übernommen und baut den Staat nach ihren Vorstellungen um. [+ pp_Full +] und alle demokratischen Kräfte sind gescheitert.

[? if civil_war_seen == 1 : Immerhin haben wir uns gewehrt. Vielleicht wird man sich in einer heute noch nicht absehbaren Zukunft an unseren Widerstand erinnern. ?]

@war_against_hitler
view-if: (chancellor_party == "AfD" or president == "Chrupalla") and (long_war == 1)
title: Die AfD regiert, doch wir leisten Widerstand.
tags: endings
go-to: eg_menu

Die AfD hat die Macht übernommen. Doch wir haben die demokratischen Kräfte des Landes versammelt und leisten Widerstand. Wie die Krise ausgeht, ist offen.


@no_hitler
view-if: chancellor_party != "AfD" and president != "Chrupalla"
title: Die AfD regiert (noch) nicht …
tags: endings
go-to: eg_menu

Die AfD ist nicht an der Macht. [? if brandmauer == 0 : Doch die Brandmauer ist gefallen, und es ist nur eine Frage der Zeit, bis Union und AfD gemeinsam regieren. ?][? if chancellor_party == "Union" and welfare < 0 : Doch der Sparkurs der Regierung und die anhaltende Krise bereiten der AfD weiter den Boden. ?]

[? if hitler_deported == 1 : Das Bundesverfassungsgericht hat Teile der AfD verboten. Hoffentlich erholt sie sich davon nie. ?]

@afd_win
view-if: hitler_deported == 1 and chancellor_party == "AfD"
title: Trotz des Verbotsurteils hat die AfD die Macht erobert …
tags: endings
go-to: eg_menu

Trotz des Verbotsurteils hat sich die AfD neu organisiert und die Macht erobert. [? if long_war == 1 : Wir kämpfen um die Zukunft der Demokratie. ?]


@civil_war_won
title: Wir haben die Staatskrise gewonnen.
view-if: republic_victory == 1
tags: endings
go-to: eg_menu

Die Demokratie hat sich gegen den Umsturz behauptet. Deutschland wird danach nicht mehr dasselbe sein, aber noch ist offen, wie es sich verändert.

@civil_war_lost
title: Wir haben die Staatskrise verloren.
view-if: total_defeat == 1
tags: endings
go-to: eg_menu

Wir haben verloren. Der Umsturz ging schnell, immerhin ohne dass Deutschland in einem Bürgerkrieg versank.

@long_war
title: Deutschland ist gelähmt.
view-if: long_war == 1
tags: endings
go-to: eg_menu

Deutschland steckt in einer Staatskrise ohne absehbares Ende. Regionen, Behörden und Gerichte stehen gegeneinander, und die Gewalt auf den Straßen nimmt zu.

[? if is_favorable == 0 : Die Lage ist für uns ungünstig. ?][? if west_relation >= 2: In Europa genießt unsere Sache viel Sympathie, doch die Regierungen zögern mit Hilfe. ?][? if soviet_aid >= 1 : Die internationale Gewerkschaftsbewegung unterstützt vor allem Linke und Klimabewegung. ?][? if east_aid >= 1 : Polen und die baltischen Staaten haben uns unterstützt. ?]


@schwesig_victorious
# party-ok: Sozialdemokratin (Schwesig, SPD)
title: Manuela Schwesig im Schloss Bellevue
view-if: president == "Schwesig"
tags: endings
go-to: eg_menu

Manuela Schwesig ist Bundespräsidentin, die erste Sozialdemokratin in diesem Amt. Sie wollte nie in die erste Reihe der Bundespolitik, und nun steht sie an der Spitze des Staates.

@president_fiedler
title: Norbert Lammert im Schloss Bellevue
view-if: president == "Lammert"
tags: endings
go-to: eg_menu

Norbert Lammert ist Bundespräsident. Als Kandidat der demokratischen Mitte soll er das zerrissene Land zusammenhalten.

@president_midyatli
# party-ok: der Linken (Trabert, Kandidat der realen Linken)
title: Gerhard Trabert ist Bundespräsident
view-if: president == "Trabert"
tags: endings
go-to: eg_menu

Gerhard Trabert, Arzt für Wohnungslose und Kandidat der Linken, ist Bundespräsident. Er will die Stimme derer sein, die sonst niemand hört.

@president_einstein
title: Ein AfD-Bundespräsident
view-if: president == "Chrupalla"
tags: endings
go-to: eg_menu

Mit [+ president +] sitzt ein AfD-Politiker im Schloss Bellevue. Das höchste Amt im Staat ist in den Händen der Feinde der Verfassung.



@spd_victorious
title: [+ pp_Full +] regiert
view-if: spd_in_government == 1 and chancellor_party == "SPD" and total_defeat == 0 and long_war == 0
tags: endings
go-to: eg_menu

[+ pp_Full +] regiert, mit [+ chancellor +] im Kanzleramt. Unter diesen Umständen ist das eine beachtliche Leistung.

@communist_victory
title: Die Linke an der Macht
view-if: player = "spd" and (chancellor_party == "Linke" or president == "Trabert" and total_defeat == 0 and long_war == 0)
tags: endings
go-to: eg_menu

Mit unserer Hilfe ist die Linke an die Spitze des Staates gelangt. Sie will Deutschland grundlegend verändern. Wie weit ihr das gelingt, ist offen.

@works_program
title: Investitionsprogramm umgesetzt!
view-if: works_program > 0
tags: endings
go-to: eg_menu

Unsere Regierung hat ein großes Investitionsprogramm umgesetzt!

@unemployment_reduced
title: Die Arbeitslosigkeit ist gesunken.
view-if: unemployed <= 10 and unemployed >= 6 and year >= 2028
tags: endings
go-to: eg_menu

Die Arbeitslosigkeit ist noch unangenehm hoch, aber weit vom Höchststand entfernt. Ein Erfolg unserer Wirtschaftspolitik.

@unemployment_reduced_2
title: Die Arbeitslosigkeit ist deutlich gesunken!
view-if: unemployed < 6 and year >= 2028
tags: endings
go-to: eg_menu

Die Arbeitslosigkeit ist deutlich gesunken! Ein Erfolg unserer Wirtschaftspolitik.



@unemployment_high
title: Die Arbeitslosigkeit ist noch zu hoch.
view-if: unemployed >= 10 and chancellor_party != "AfD" and (total_defeat == 0) and long_war == 0
tags: endings
go-to: eg_menu

Die Arbeitslosigkeit ist gefährlich hoch. Auch wenn die AfD nicht regiert, ist der Boden für Instabilität und Extremismus bereitet.


@emergency_government
title: [+ pp_Full +] in einer Notstandsregierung.
view-if: in_emergency_government == 1
tags: endings
go-to: eg_menu

[+ pp_Full +] regiert in einer Notstandsregierung unter Bundespräsident\*in [+ president +] und Kanzler\*in [+ chancellor +]. Das ist eine instabile Übergangslösung, die autoritären Versuchungen die Tür öffnet.

@peoples_party_achieved
title: [? if player = "spd" : Die SPD ist wieder Volkspartei. ?][? if player = "linke" : Die Linke ist wieder die Partei des Ostens. ?]
view-if: peoples_party == 1
tags: endings
go-to: eg_menu

[? if player = "spd" : Die SPD versteht sich wieder als Volkspartei für alle, nicht nur für die Beschäftigten. ?][? if player = "linke" : Die Linke versteht sich wieder als Kümmererpartei für die Menschen im Osten, nicht nur für die jungen Großstädter*innen. ?] Der Kurs hat Anhänger und Kritiker, und was aus der Partei wird, ist offen.

@nationalization_achieved
title: Schlüsselindustrien sind in öffentlicher Hand.
view-if: nationalization_progress >= 2
tags: endings
go-to: eg_menu

Mit unserem Transformationsplan haben wir einen bedeutenden Teil der Industrie in öffentliche Hand geholt, der Beginn einer demokratisch-sozialistischen Wirtschaft.

@works_councils
title: Mehr Mitbestimmung.
view-if: works_councils >= 3
tags: endings
go-to: eg_menu

Betriebs- und Branchenräte haben deutlich mehr Einfluss. Beschäftigte bestimmen über ihr Arbeitsleben mit.

@european_union
title: Es gibt eine Europäische Föderation!
view-if: eu = 1
tags: endings
go-to: eg_menu

Wir haben die Gründung einer Europäischen Föderation vorangetrieben, für Frieden und Wohlstand auf dem Kontinent. Die Zeit wird zeigen, wie gut sie funktioniert.

@achievements
# party-ok: SPD, Volkspartei, Sozialdemokratin, die Linke (SPD-Bundespräsidentin Schwesig, Sohn seiner Klasse = reale Linke, Rot-Rot und Rot-Grün-Rot als reale Parteinamen, Große Volkspartei als Maßstab)
title: Erfolge
view-if: achievement_game_completed == 1
tags: endings
go-to: eg_menu if started == 1; root.start_menu_2 if started == 0

= Erfolge in diesem Durchgang


[? if game_achievement_eiserne_front : **Bündnis für Demokratie** – ein breites Bündnis für Demokratie schmieden. ?]

[? if game_achievement_civil_war : **Staatskrise** – in eine lang anhaltende Staatskrise geraten. ?]

[? if game_achievement_einigkeit : **Einigkeit** – das Spielende ohne Staatskrise auf „Leicht“ erreichen. ?]

[? if game_achievement_einigkeit_und_recht : **Einigkeit und Recht** – das Spielende ohne Staatskrise auf „Normal“ erreichen. ?]

[? if game_achievement_einigkeit_und_recht_und_freiheit : **Einigkeit und Recht und Freiheit** – das Spielende ohne Staatskrise auf „Schwer“ erreichen. ?]

[? if game_achievement_schwarz_rot_gold : **Schwarz-Rot-Gold** – das Spielende ohne Staatskrise im historischen Modus erreichen. ?]

[? if game_achievement_in_kummernis_und_dunkelheit : **In Kümmernis und Dunkelheit** – das Spielende ohne Staatskrise auf der schwersten eigenen Schwierigkeit erreichen. ?]

[? if game_achievement_victory_for_the_republic: **Sieg für die Demokratie** – die Staatskrise gewinnen. ?]

[? if game_achievement_bollwerk_der_demokratie: **Bollwerk der Demokratie** – einen Umsturzversuch abwehren und gewinnen. ?]

[? if game_achievement_red_tzar_of_prussia : **Rote Doppelspitze** – Manuela Schwesig ist Bundespräsidentin und [+ pp_full +] stellt Kanzlerschaft und starke Länder. ?]

[? if game_achievement_einheitsfront: **Rot-Rot** – eine Regierung aus SPD und Linken bilden. ?]

[? if game_achievement_einheitsfront_2: **Sieg für Rot-Rot** – eine rot-rote Koalition, die alle Forderungen des Partners erfüllt. ?]

[? if game_achievement_volksfront: **Rot-Grün-Rot** – eine Regierung aus SPD, Grünen und Linken bilden. ?]

[? if game_achievement_grosse_volksfront: **Große Koalition der Vernunft** – mit Hendrik Wüst an der Spitze der CDU und dem kooperativen Flügel an der Spitze [+ op_dat +] eine Regierung aller demokratischen Parteien bilden. ?]

[? if game_achievement_volksfront_2: **Sieg für Rot-Grün-Rot** – eine rot-grün-rote Koalition, die alle Forderungen des Partners erfüllt. ?]

[? if game_achievement_constitutional_coalition: **Koalition der Mitte** – eine „Koalition der Mitte“ bilden. ?]

[? if game_achievement_weimar_coalition: **Kenia** – eine Koalition aus Union, SPD und Grünen bilden. ?]

[? if game_achievement_majority_party: **Mehrheitspartei** – eine Alleinregierung [+ pp_dat +] mit eigener Mehrheit bilden. ?]

[? if game_achievement_minderheitsregierung: **Minderheitsregierung** – eine Minderheitsregierung [+ pp_dat +] bilden. ?]

[? if game_achievement_volkspartei: **Volkspartei** – [+ pp_full +] ist wieder Volkspartei. ?]

[? if game_achievement_sohn_seiner_klasse: **Sohn seiner Klasse** – die Linke stellt das Staatsoberhaupt oder die Kanzlerschaft. ?]

[? if game_achievement_rote_millionar: **Der rote Millionär** – ein linker Unternehmer wird Bundespräsident. ?]

[? if game_achievement_versohnler: **Versöhnler** – der kooperative Flügel führt [+ op_full +]. ?]

[? if game_achievement_deport_hitler : **Wehrhafte Demokratie** – ein erfolgreiches AfD-Verbotsverfahren. ?]

[? if game_achievement_wirtschaftspolitik: **Wirtschaftspolitik** – ein Wirtschaftsprogramm umsetzen. ?]

[? if game_achievement_wirtschaftswunder: **Wirtschaftswunder** – ab 2029 weniger Arbeitslosigkeit als zu Spielbeginn, Inflation unter 5 % und Haushaltsspielraum. ?]

[? if game_achievement_wirtschaftsexperiment: **Wirtschaftsexperiment** – zwei verschiedene Wirtschaftsprogramme umsetzen. ?]

[? if game_achievement_freie_marktwirtschaft: **Freie Marktwirtschaft** – das Spielende ohne Wirtschaftsprogramm erreichen. ?]

[? if game_achievement_equality: **Gleichheit** – Reformen für die Gleichstellung durchsetzen. ?]

[? if game_achievement_hirschfeld: **Regenbogen** – Reformen für queere Rechte durchsetzen. ?]

[? if game_achievement_women_reichsbanner: **Omas gegen Rechts** – Frauen stehen in der ersten Reihe der Demokratiebewegung. ?]

[? if game_achievement_anders_als_die_andern: **Anders als die Andern** – queere Menschen verteidigen die Demokratie. ?]

[? if game_achievement_bruder_zur_sonne: **Brüder, zur Sonne, zur Freiheit** – Arbeitslosigkeit senken, EU-Investitionsausnahme erreichen, Gleichstellung voranbringen, eine SPD-Bundespräsidentin wählen und ein AfD-Verbotsverfahren gewinnen, in einem Durchgang auf mindestens „Normal“. ?]

[? if game_achievement_die_rote_fahne: **Die Rote Fahne** – mit [+ op_dat +] am 1. Mai demonstrieren. ?]

[? if game_achievement_panik_im_mittelstand: **Panik im Mittelstand** – mindestens 50 % Zustimmung in der akademischen Mittelschicht. ?]

[? if game_achievement_bauernrevolution: **Bauernrevolution** – mindestens 50 % Zustimmung im ländlichen Raum. ?]

[? if game_achievement_katholischer_sozialismus: **Generationenvertrag** – mindestens 50 % Zustimmung bei Rentner\*innen. ?]

[? if game_achievement_grosse_volkspartei: **Große Volkspartei** – in allen Wählergruppen mindestens 40 % Zustimmung. ?]

[? if game_achievement_klassenkampf: **Klassenkampf** – mindestens 80 % bei Arbeitnehmer\*innen, unter 20 % in Mittelschicht und ländlichem Raum. ?]

[? if game_achievement_raterepublik: **Räterepublik** – den Umbau zu einer demokratischen sozialistischen Wirtschaft beginnen. ?]

[? if game_achievement_polykrise: **Polykrise** – einen Investitionsstreik und einen Umsturzversuch überstehen. ?]

[? if game_achievement_syndikalismus: **Syndikalismus** – Werksübernahmen durch die Belegschaften unterstützen. ?]

[? if game_achievement_drei_pfeile: **Drei Pfeile** – einen Umsturzversuch ohne Staatskrise abwehren. ?]

[? if game_achievement_ausnahmezustand: **Ausnahmezustand** – mit Notstandsbefugnissen Wahlen aussetzen. ?]

[? if game_achievement_eu: **Vereinigte Staaten von Europa** – eine Europäische Föderation gründen. ?]

[? if game_achievement_heidelberger_programm: **Heidelberger Programm** – die Ziele des Heidelberger Programms erreichen: Sozialstaat, Justizreform, Gleichstellung in Beruf und Familie, gerechte Steuern, Mitbestimmung und eine Europäische Föderation. ?]

[? if game_achievement_verfassungsreform: **Verfassungsreform** – das Grundgesetz ändern. ?]

[? if game_achievement_zeppelin_kapitan : **Überparteilich** – eine parteilose Persönlichkeit wird Bundespräsident\*in. ?]

[? if game_achievement_wahlrechts : **Frauenwahlrecht** – eine Sozialdemokratin wird Bundespräsidentin. ?]

[? if game_achievement_bundesrepublik : **Bundesrepublik** – eine besonders angesehene Persönlichkeit wird Bundespräsident\*in. ?]

[? if game_achievement_republik_der_wissenschaft : **Republik der Wissenschaft** – eine Wissenschaftlerin oder ein Wissenschaftler wird Bundespräsident\*in. ?]

[? if game_achievement_arbeiter_von_wien : **Arbeiter von Wien** – die SPÖ siegt in Österreich. ?]

[? if game_achievement_stolperstein: **Stolperstein** – wir haben verloren, doch die Geschichte wird sich an uns erinnern … ?]



= Completed Achievements Overall


[? if achievement_eiserne_front : **Bündnis für Demokratie** – ein breites Bündnis für Demokratie schmieden. ?]

[? if achievement_civil_war : **Staatskrise** – in eine lang anhaltende Staatskrise geraten. ?]

