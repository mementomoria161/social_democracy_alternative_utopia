title: Election Simulation
set-jump: post_election


- @1928: 1928 historical scenario
- @1930: 1930 historical scenario
- @1932: 1932 (July) historical scenario

@1928
on-arrival: {!
Q.workers = 46; // industry and trade
Q.old_middle = 13; // "old mittelstand"
// 16.4 trade & commerce, 6.6 public and private services, 4.4 domestic help
Q.new_middle = 14; // "new mittelstand"
Q.rural = 25; // agriculture and forestry employment... but many of those are proletarians so...
// source: https://surface.syr.edu/cgi/viewcontent.cgi?filename=3&article=1016&context=books&type=additional page 43, table 3.3
Q.unemployed = 8.6;
Q.catholics = 30;

Q.classes = ['workers', 'old_middle', 'new_middle', 'rural', 'unemployed', 'rentner'];
Q.parties = ['spd', 'linke', 'union', 'gruene', 'fdp', 'bsw', 'afd', 'other'];

// Support for party by social group
// they don't have to sum to 100 since the electoral calculations will be normalized.
Q.workers_spd = 65;
Q.workers_linke = 20;
Q.workers_union = 5;
Q.workers_gruene = 0;
Q.workers_fdp = 0;
Q.workers_bsw = 5;
Q.workers_afd = 0;
Q.workers_other = 10;

Q.old_middle_spd = 5;
Q.old_middle_linke = 0;
Q.old_middle_union = 5;
Q.old_middle_gruene= 10;
Q.old_middle_fdp = 25;
Q.old_middle_bsw = 25;
Q.old_middle_afd = 10;
Q.old_middle_other = 10;

Q.new_middle_spd = 5;
Q.new_middle_linke = 0;
Q.new_middle_union = 10;
Q.new_middle_gruene= 25;
Q.new_middle_fdp = 25;
Q.new_middle_bsw = 10;
Q.new_middle_afd = 5;
Q.new_middle_other = 15;

Q.rural_spd = 10;
Q.rural_linke = 0;
Q.rural_union = 5;
Q.rural_gruene= 5;
Q.rural_fdp = 15;
Q.rural_bsw = 45;
Q.rural_afd = 5;
Q.rural_other = 10;

Q.unemployed_spd = 25;
Q.unemployed_linke = 55;
Q.unemployed_union = 1;
Q.unemployed_gruene = 0;
Q.unemployed_fdp = 0;
Q.unemployed_bsw = 5;
Q.unemployed_afd = 15;
Q.unemployed_other = 9;

Q.rentner_spd = 15;
Q.rentner_linke = 5;
Q.rentner_union = 50;
Q.rentner_gruene = 0;
Q.rentner_fdp = 5;
Q.rentner_bsw = 5;
Q.rentner_afd = 0;
Q.rentner_other = 10;
!}
go-to: election_algorithm
set-jump: post_election

