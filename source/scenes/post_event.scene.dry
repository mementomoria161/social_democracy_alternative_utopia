title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// many events hand a ministry to another party without naming a minister: use that party's default then
var default_ministers = {
    'SPD': {foreign: 'Mützenich', interior: 'Fiedler', justice: 'Hubig', labor: 'Bas', bundeswehr: 'Pistorius', economic: 'Hubertz', finance: 'Klingbeil', agriculture: 'Miersch'},
    'Union': {foreign: 'Wadephul', interior: 'Dobrindt', justice: 'Krings', labor: 'Linnemann', bundeswehr: 'Kiesewetter', economic: 'Reiche', finance: 'Frei', agriculture: 'Rainer'},
    'Grüne': {foreign: 'Brantner', interior: 'von Notz', justice: 'Haßelmann', labor: 'Banaszak', bundeswehr: 'Nouripour', economic: 'Dröge', finance: 'Kellner', agriculture: 'Özdemir'},
    'Linke': {foreign: 'van Aken', interior: 'Bartsch', justice: 'Bünger', labor: 'Reichinnek', bundeswehr: 'Pellmann', economic: 'Ramelow', finance: 'Görke', agriculture: 'Schwerdtner'},
    'FDP': {foreign: 'Lambsdorff', interior: 'Kubicki', justice: 'Kubicki', labor: 'Vogel', bundeswehr: 'Strack-Zimmermann', economic: 'Dürr', finance: 'Dürr', agriculture: 'Vogel'},
    'AfD': {interior: 'Chrupalla', justice: 'Brandner', agriculture: 'Protschka'}
};
// the keys are slot strings: when the Linke is played, slot 'SPD' holds the Linke and slot 'Linke' the SPD
// (events hard-code SPD names in slot 'SPD'; the check below replaces them by the Linke defaults)
if (Q.player == 'linke') {
    var t = default_ministers['SPD']; default_ministers['SPD'] = default_ministers['Linke']; default_ministers['Linke'] = t;
}
var real_spd = Q.player == 'linke' ? 'Linke' : 'SPD';
// ministers of the start cabinet (Scholz, November 2024) that are not default ministers
var minister_party_of = {'Frei': 'Union', 'Wissing': 'parteilos', 'Baerbock': 'Grüne', 'Habeck': 'Grüne',
                         'Faeser': real_spd, 'Kukies': real_spd, 'Heil': real_spd};
for (var mp in default_ministers) {
    for (var post in default_ministers[mp]) {
        minister_party_of[default_ministers[mp][post]] = mp;
    }
}
for (var post of ['foreign', 'interior', 'justice', 'labor', 'bundeswehr', 'economic', 'finance', 'agriculture']) {
    var holder = Q[post + '_minister'];
    var holder_party = Q[post + '_minister_party'];
    if (minister_party_of[holder] && minister_party_of[holder] != holder_party) {
        Q[post + '_minister'] = (default_ministers[holder_party] || {})[post] || 'N. N.';
    }
}
// make sure no stat is below 0.
for (var c of Q.classes) {
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
    }
}

// Kampagneneffekt (Nov. 2026): Überzeugungseffekte von Wahlkampf-Kontakten und -Werbung sind in Hauptwahlen im Mittel null,
// frühe Effekte verfliegen (Kalla/Broockman, American Political Science Review 2018: 40 Feldexperimente plus 9 eigene);
// Mobilisierung kurz vor der Wahl wirkt. Die Karten Medien, Kundgebung, Wahlkampf, Bündnis für Demokratie, Demokratiebewegung
// und „Der AfD entgegentreten“ (Mobilisierung) sowie die Werbekarten „Volkspartei“ (SPD) und „Wieder Volkspartei im Osten?“
// (Linke) setzen kampagne_card = 1: Ihr Zugewinn für die Spielerpartei bleibt nur zu 10 % dauerhaft. Wahlkampf vor Ort
// (Karte Wahlkampf mit Haustürgesprächen, kampagne_card = 2) bleibt zu 30 %: Haustürwahlkampf überzeugt in Europa auch
// dauerhaft (Pons, American Economic Review 2018). Die Hälfte des Rests wirkt als Kampagneneffekt (Q.kampagne, Prozentpunkte),
// der mit 15 % im Monat abklingt (Monatswechsel unten), in den drei Monaten vor einer Wahl anderthalbfach. Vorher blieb alles
// dauerhaft, und die Medienkarte war die dominante Strategie.
var natShare = function(p) {
    var num = 0, den = 0;
    for (var c of Q.classes) {
        var t = 0;
        for (var q of Q.parties) t += Math.max(0, Q[c + '_' + q] || 0);
        if (t > 0) num += Q[c] * Math.max(0, Q[c + '_' + p] || 0) / t;
        den += Q[c];
    }
    return den ? 100 * num / den : 0;
};
if (Q.kampagne_card && Q.pp_snap) {
    var k_before = natShare('spd');
    for (var c of Q.classes) {
        var k_gain = (Q[c + '_spd'] || 0) - (Q.pp_snap[c] || 0);
        if (k_gain > 0) Q[c + '_spd'] -= (Q.kampagne_card == 2 ? 0.7 : 0.9) * k_gain;
    }
    var k_near = Q.next_election_time && Q.next_election_time - Q.time <= 3;
    Q.kampagne = Math.round(((Q.kampagne || 0) + 0.5 * (k_before - natShare('spd')) * (k_near ? 1.5 : 1)) * 100) / 100;
}
Q.kampagne_card = 0;
// den Kampagneneffekt als vorübergehende Abweichung anwenden: Spielerpartei in allen Gruppen auf den aktuellen Wert skalieren
var k_delta = (Q.kampagne || 0) - (Q.kampagne_applied || 0);
if (Math.abs(k_delta) > 0.01) {
    var k_sh = natShare('spd');
    if (k_sh > 0.5) {
        var k_f = Math.max(0.85, Math.min(1.15, (k_sh + k_delta) / k_sh));
        for (var c of Q.classes) Q[c + '_spd'] *= k_f;
        Q.kampagne_applied = Math.round(((Q.kampagne_applied || 0) + natShare('spd') - k_sh) * 100) / 100;
    }
}

Q.pro_republic = Math.round(Q.pro_republic);
Q.nationalism = Math.round(Q.nationalism);
Q.socialism = Math.round(Q.socialism);

if (Q.pro_republic < 0) {
    Q.pro_republic = 0;
}
if (Q.pro_republic >= 100) {
    Q.pro_republic = 99;
}
// re-calculate party support
// calculate normalized class voting for the achievements
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}
// calculate support for each of the parties
var total_support = 0; 
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) { 
            party_support += Q[c]*Q[c+'_'+party];
        } else  { 
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        } 
    }
    Q[party + '_support'] = party_support;
    total_support += party_support; 
}
// 2. normalize support (fraction)
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    Q[party+'_votes'] = Math.round(Q[party+'_normalized']*100);
    Q[party+'_votes_display'] = Math.round(Q[party+'_normalized']*100);
}


// set faction strength/dissent to 0
for (var c of Q.factions) {
    if (Q[c+'_dissent'] < 0) {
        Q[c+'_dissent'] = 0;
    } else if (Q[c+'_dissent'] >= 100) {
        Q[c+'_dissent'] = 99;
    }
    if (Q[c+'_strength'] < 0) {
        Q[c+'_strength'] = 0;
    }
}

if (Q.unemployed <= 1) {
    Q.unemployed = 1;
}

// re-calculate dissent.
var total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.neorevisionist_strength;

// normalize strength for the different factions
Q.left_strength = 100*Q.left_strength/total_strength;
Q.center_strength = 100*Q.center_strength/total_strength;
Q.labor_strength = 100*Q.labor_strength/total_strength;
Q.reformist_strength = 100*Q.reformist_strength/total_strength;
Q.neorevisionist_strength = 100*Q.neorevisionist_strength/total_strength;

var total_dissent = Q.left_strength*Q.left_dissent + Q.center_strength*Q.center_dissent + Q.labor_strength*Q.labor_dissent + Q.reformist_strength*Q.reformist_dissent + Q.neorevisionist_strength*Q.neorevisionist_dissent;


Q.dissent = 0.01*total_dissent/total_strength;
Q.dissent_percent = Q.dissent*100;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

////////////////////////// Wirtschaftssektoren (Durchgang 4.4, Reiter Wirtschaft)
// Bruttowertschöpfung 2024 in jeweiligen Preisen: 3 979,6 Mrd. Euro (Summe der Quartale; Destatis, Konjunkturindikatoren VGR,
// destatis.de/.../Volkswirtschaftliche-Gesamtrechnungen/vgr210.html, Stand 30.09.2026). Anteile daraus: Produzierendes Gewerbe
// ohne Bau 23,4 % (davon Verarbeitendes Gewerbe 19,9 %, destatis.de/Europa, Thema Industrie; Energie/Wasser/Bergbau als Rest 3,5 %),
// Baugewerbe 5,1 %, Handel/Verkehr/Gastgewerbe 16,3 %; Dienstleistungsbereiche zusammen 70,6 % (Statista nach Destatis), Land- und
// Forstwirtschaft als Rest 0,9 %. Die Aufteilung der übrigen Dienstleistungsbereiche ist geschätzt (Struktur der Vorjahre, auf 70,6 % abgestimmt).
// Startraten: reale Veränderung der Bruttowertschöpfung 2024 (Destatis, Pressemitteilung Nr. 017 vom 15.01.2026);
// Energie, Finanzen, Wohnungswesen und Landwirtschaft dort nicht ausgewiesen (geschätzt).
// Reihenfolge der Arrays sector_value/sector_growth/sector_why und der Records wie SECTORS (Namen und Texte: out/html/game.js, ECON_SECTORS).
var SECTORS = ['industrie', 'energie', 'bau', 'handel', 'ikt', 'finanzen', 'wohnen', 'dienste', 'oeffentlich', 'sonstige', 'agrar'];
if (!Q.sector_value || !Q.sector_value.length) {
    Q.sector_value = [19.9, 3.5, 5.1, 16.3, 4.9, 3.7, 10.6, 11.5, 19.7, 3.9, 0.9].map(function(s) { return Math.round(s * 39.796 * 10) / 10; });
    Q.sector_growth = [-4.3, -1.0, -3.8, 0.2, 2.1, 0.5, 0.5, 0.8, 1.2, 1.0, 0];
    Q.sector_records = [];
    Q.sector_why = SECTORS.map(function() { return ''; });
}

// 1. update dates
if (Q.month_actions >= 1) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.month += 1;
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
        if (Q.annual_income > 0) {
            Q.resources += Q.annual_income;
        }
    }
    // decrement timers
    for (timer of Q.timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }
    // append to historical party support records
    var party_support_results = {'date': new Date(Q.year, Q.month - 1)};
    for (var party of Q.parties) {
        party_support_results[party] = Q[party + '_normalized']*100;
        for (var c of Q.classes) {
            party_support_results[c + '_' + party] = Q[c + '_' + party + '_normalized'];
        }
    }
    Q.party_support_records.push(party_support_results);
    Q.economic_records.push({'date': new Date(Q.year, Q.month - 1),
                             'inflation': Math.round(Q.inflation * 100) / 100,
                             'unemployment': Math.round(Q.unemployed * 100) / 100,
                             'growth': Math.round((Q.economic_growth || 0) * 100) / 100,
                             'budget': Q.budget});

    // Sektoren: jede Branche hat eine eigene Jahresrate um das Gesamtwachstum (Grundtrend, Konjunkturempfindlichkeit BETA,
    // Politik und Ereignisse). Danach werden alle Raten so verschoben, dass ihr mit den Anteilen gewichtetes Mittel genau
    // economic_growth ist. Das Sektormodell wirkt nicht auf economic_growth und die Arbeitslosigkeit zurück (Balancing unverändert).
    // Schnittstelle für Ereignisse, Gruppen (4.5) und Klima (4.6): shock_<sektor> (Prozentpunkte Jahresrate, klingt mit 8 % im Monat ab),
    // energy_price (Index, 2024 = 100; teurere Energie bremst die Industrie).
    var g = Q.economic_growth || 0, cyc = g - 1;
    var TREND = [-0.8, 0.3, Q.year >= 2026 ? 0.3 : -1.5, 0, 2.0, 0, 0.2, 0.3, 0.8, 0, -0.5];
    var BETA = [1.7, 0.6, 1.4, 1.2, 0.8, 1.0, 0.3, 1.2, 0.2, 0.8, 0.3];
    var S = {}; SECTORS.forEach(function(s, i) { S[s] = i; });
    var pol = SECTORS.map(function() { return 0; }), why = SECTORS.map(function() { return []; });
    var add = function(s, v, text) { pol[S[s]] += v; why[S[s]].push(text); };
    // one-time shocks when an event happened first (Q.sector_done: flag -> month of the event)
    var ONE_TIME = [['industriekrise_seen', 'Industriekrise', {industrie: -2.5}],
                    ['zollstreit_2025_seen', 'US-Zölle 2025', {industrie: -1.5}],
                    ['black_thursday_seen', 'Zollkrieg', {industrie: -3, handel: -1.5, finanzen: -1}],
                    ['banking_crisis_seen', 'Bankenkrise', {finanzen: -4, bau: -1.5, wohnen: -1}],
                    ['capital_strike_seen', 'Investitionsstreik', {industrie: -3, bau: -2, dienste: -1.5}],
                    ['ukraine_ceasefire_seen', 'Waffenstillstand in der Ukraine', {industrie: 1, bau: 1, energie: 0.5}]];
    Q.sector_done = Q.sector_done || {};
    ONE_TIME.forEach(function(e) {
        if (!Q[e[0]]) return;
        if (Q.sector_done[e[0]] === undefined) {
            Q.sector_done[e[0]] = Q.time;
            for (var s in e[2]) Q['shock_' + s] = (Q['shock_' + s] || 0) + e[2][s];
        }
        if (Q.time - Q.sector_done[e[0]] < 18) {
            for (var s in e[2]) why[S[s]].push((e[2][s] < 0 ? 'Nachwirkung: ' : 'Auftrieb: ') + e[1]);
        }
    });
    if (Q.tariffs > 0) add('industrie', -0.6 * Math.min(Q.tariffs, 3), 'Zölle belasten den Export');
    if (Q.sondervermoegen == 2 && Q.year >= 2026) {
        add('bau', 1.0, 'Sondervermögen Infrastruktur');
        add('industrie', 0.3, 'Sondervermögen Infrastruktur');
    }
    if (Q.sondervermoegen >= 1 && Q.year >= 2026) add('industrie', 0.4, 'Rüstungsaufträge');
    if (Q.works_program > 0) {
        add('bau', 0.6 * Math.min(Q.works_program, 3), 'Investitionsoffensive');
        add('industrie', 0.2 * Math.min(Q.works_program, 3), 'Investitionsoffensive');
    }
    if (Q.bau_offensive > 0) {
        add('bau', 0.6 * Math.min(Q.bau_offensive, 2), 'Bau-Offensive im Wohnungsbau');
        add('wohnen', 0.2, 'Bau-Offensive im Wohnungsbau');
    }
    if (Q.welfare > 0) add('oeffentlich', 0.25 * Math.min(Q.welfare, 4), 'Ausbau des Sozialstaats');
    if (Q.science_bonus > 0) {
        add('ikt', 0.2 * Q.science_bonus, 'Forschung und Bildung');
        add('dienste', 0.05 * Q.science_bonus, 'Forschung und Bildung');
    }
    var ep = Q.energy_price || 100;
    if (Math.abs(ep - 100) >= 5) {
        add('industrie', -0.03 * (ep - 100), ep > 100 ? 'hohe Energiepreise' : 'günstigere Energie');
        add('energie', 0.01 * (ep - 100), ep > 100 ? 'hohe Energiepreise' : 'günstigere Energie');
    }
    if (Q.inflation > 4) add('handel', -0.5, 'hohe Inflation dämpft den Konsum');
    var rate = Q.sector_growth.map(function(r, i) {
        var shock = Q['shock_' + SECTORS[i]] || 0;
        if (shock && Math.abs(shock) < 0.05) shock = 0;
        Q['shock_' + SECTORS[i]] = Math.round(shock * 0.92 * 100) / 100;
        var target = Math.max(-15, Math.min(15, g + TREND[i] + (BETA[i] - 1) * cyc + pol[i] + shock));
        return r + 0.2 * (target - r);
    });
    var total = Q.sector_value.reduce(function(a, b) { return a + b; }, 0);
    var mean = rate.reduce(function(a, r, i) { return a + r * Q.sector_value[i] / total; }, 0);
    Q.sector_growth = rate.map(function(r) { return Math.round((r + g - mean) * 100) / 100; });
    Q.sector_value = Q.sector_value.map(function(v, i) { return Math.round(v * (1 + Q.sector_growth[i] / 1200) * 100) / 100; });
    Q.sector_why = why.map(function(a) { return a.join('; '); });
    Q.sector_records.push({'date': new Date(Q.year, Q.month - 1), 'v': Q.sector_value.map(function(v) { return Math.round(v * 10) / 10; })});
    // Interessengruppen und Bewegungen (Durchgang 4.5): Stärke, Konjunktur, Verhältnis, Druck auf Strömungen und Wählergruppen.
    // Tabelle, Treiber und Wirkungen: groups_data.scene.dry (GRP.month).
    if (!this.game.GRP) this._runActions(this.game.scenes.groups_data.onArrival);
    this.game.GRP.month(Q);
    // Klima und Energie (Durchgang 4.6): Strommix, Emissionen, Energiepreise (speist energy_price), Prognose, Paris-Budget.
    // Modell und Quellen: climate_data.scene.dry (CLIM.month). Läuft vor der Phillips-Kurve, damit die Energiepreise auf die Inflation wirken.
    if (!this.game.CLIM) this._runActions(this.game.scenes.climate_data.onArrival);
    this.game.CLIM.month(Q);
    // change economic stats...
    // we're basically implicity drawing a Philips curve, scaled to the German economy of the 2020s
    // budget deficits lead to some inflation
    if (Q.budget <= 0 && Q.budget > -2 && Q.inflation < 2.5) {
        Q.inflation += 0.1;
    }
    if (Q.budget <= -2 && Q.budget > -5 && Q.inflation < 4) {
        Q.inflation += 0.15;
        if (Q.unemployed >= 8) {
            Q.inflation -= 0.05;
        }
    }
    if (Q.budget <= -5 && Q.inflation < 8) {
        Q.inflation += 0.25;
        if (Q.unemployed >= 10) {
            Q.inflation -= 0.1;
        }
    }
    // deflation is bad
    if (Q.inflation < -0.5 && Q.inflation > -3 && Q.unemployed < 10) {
        Q.unemployed += 0.1;
    }
    if (Q.inflation <= -3 && Q.unemployed < 11) {
        Q.unemployed += 0.2;
    }
    // economic growth and unemployment
    // stagnation slowly pushes up unemployment (2023-2026: from 5.7% to 6.3%)
    if (Q.economic_growth < 0.5 && Q.unemployed <= 7) {
        Q.unemployed += 0.02;
    }
    if (Q.economic_growth < -0.5 && Q.unemployed <= 10) {
        Q.unemployed += 0.06;
    }
    if (Q.economic_growth < -3 && Q.unemployed <= 11) {
        Q.unemployed += 0.1;
    }
    if (Q.economic_growth >= 1.5 && Q.unemployed >= 5) {
        Q.unemployed -= 0.05;
    }
    if (Q.economic_growth >= 3 && Q.unemployed >= 4) {
        Q.unemployed -= 0.05;
    }
    if (Q.economic_growth >= 4.5 && Q.unemployed >= 3) {
        Q.unemployed -= 0.05;
    }
    if (Q.economic_growth >= 2 && Q.inflation >= 5) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= -2 && Q.inflation <= -3) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 3) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 5) {
        Q.economic_growth -= 0.2;
    }

    //////////////////////////////// Education & Science support/economic changes
    if (Q.major_curriculum && Q.major_curriculum == "Demokratiebildung") {
        if (Q.pro_republic < 65) {
            Q.pro_republic += 0.5;
        }
    }
    if (Q.minor_curriculum && Q.minor_curriculum == "Demokratiebildung") {
        if (Q.pro_republic < 65) {
            Q.pro_republic += 0.3;
        }
    }
    // science bonus to economic growth
    Q.science_bonus = 0;
    if (Q.education_science) {
        Q.science_bonus += Q.education_science;
    }
    if (Q.science) {
        if (Q.science >= 5) {
            Q.science_bonus += 3;
        } else if (Q.science >= 3) {
            Q.science_bonus += 2;
        } else if (Q.science >= 1) {
            Q.science_bonus += 1;
        }
    }
    if (Q.applied_research && Q.applied_research >= 1) {
        Q.science_bonus += 0.5*Q.applied_research;
    }
    // cap the science bonus at 6
    if (Q.science_bonus > 6) {
        Q.science_bonus = 6;
    }
    // more science -> higher levels of baseline growth (scaled: a bonus of 6 means about +3% baseline growth)
    if (Q.science_bonus >= 1) {
        if (Q.return_to_normalcy && Q.economic_growth < 1 + Q.science_bonus/2) {
            Q.economic_growth += 0.05;
        }
        if (Q.economic_growth < Q.science_bonus/2 - 1) {
            Q.economic_growth += 0.05;
        }
    }
    // Konjunktur kehrt zum Trend zurück (Port 2026, nach dem realen Verlauf bis November 2026): Schocks aus Ereignissen
    // (Jahreswechsel, Zollkrieg, Bankenkrise, Investitionsstreik) klingen ab, statt das Wachstum für den Rest des Spiels
    // zu senken (vorher bis −5 bis −9 % im Jahr 2030; schlechtestes reales Jahr: 2009 mit −5,7 %).
    // Trend = Potenzialwachstum 0,4 % (Sachverständigenrat, Frühjahrsgutachten Mai 2024: 0,5 % im Jahr 2024, danach sinkend;
    // 0,4 % für die späten 2020er ist eine Spielannahme) plus Politik (Spielannahmen):
    // Investitionsprogramm (works_program, je Stufe +0,4, höchstens drei), Sondervermögen Infrastruktur (sondervermoegen),
    // Forschung (science_bonus, höchstens +1,5). Tempo: 4 % der Lücke je Monat, gut 40 % im Jahr.
    if (Q.year * 12 + Q.month > 2026 * 12 + 11) {
        var trend = 0.4 + 0.4 * Math.min(3, Q.works_program || 0) + 0.25 * Math.min(6, Q.science_bonus || 0);
        if (Q.sondervermoegen >= 1) trend += 0.3;
        if (Q.sondervermoegen >= 2) trend += 0.2;
        Q.growth_trend = Math.round(trend * 100) / 100;
        Q.economic_growth += 0.04 * (trend - Q.economic_growth);
        // Erholung baut Arbeitslosigkeit ab (Okun, grob): ab 0,5 % Wachstum sinkt die Quote langsam Richtung 5,5 %,
        // ab 1 % schneller (zusammen mit der Regel ab 1,5 % oben bis gut 1 Prozentpunkt im Jahr)
        if (Q.economic_growth >= 0.5 && Q.unemployed > 5.5) {
            Q.unemployed -= 0.02;
        }
        if (Q.economic_growth >= 1 && Q.unemployed > 5.5) {
            Q.unemployed -= 0.02;
        }
    }
    // accumulated economic growth/decline
    if (Q.economic_growth < 0) {
        if (Q.economic_expansion > 0) {
            Q.economic_expansion = 0;
        } else {
            Q.economic_expansion += Q.economic_growth;
        }
    }
    if (Q.economic_growth > 0 && Q.spd_in_government) {
        Q.economic_expansion += 1.5*Q.economic_growth;
    }
    /////////////////////////////// update opinions based on economy
    if (Q.unemployed > 8 && Q.pro_republic > 40) {
        Q.pro_republic -= 0.5;
    }
    if (Q.unemployed > 11 && Q.pro_republic > 20) {
        Q.pro_republic -= 1;
    }
    if (Q.inflation >= 5 && Q.pro_republic > 40) {
        Q.pro_republic -= 1;
    }

    ///////////////////////////// (bis Nov. 2026: Abwanderung zur AfD, wenn pro_republic < SPD + Union + Grüne − 3)
    // Entfernt (Weimar-Vorlage: Vertrauen in die Republik gegen Stimmenanteil der Weimarer Koalition). Der Vergleich von
    // Vertrauen mit Stimmenanteilen hat keine empirische Grundlage und wirkte zusätzlich zum Treiber „Vertrauen in die
    // Demokratie“ im Umfragetrend unten (doppelt gezählt).

    ////////////////////////// Linke game: less attention for a small opposition party (Durchgang 4.3)
    // In opposition, gains of the player slot since the last month change count only with LK_GAIN (losses fully).
    // Calibrated with node tools/sim.js . 60 linke (random play): 2025 election about 9.5 % of the votes / 11 % of the
    // seats (real 8.8 / 10.2), Dec 2025 and Nov 2026 about 12.5-13 % (real 10.6 / about 11). Without it: 10.8, 15.6, 17.2.
    // Durchgang 4.7: targeted play pays off. Every organizing action (Haustürgespräche, Sozialsprechstunden,
    // Mietwucher-Rechner: lk_orga) earns attention (bis Nov. 2026: +0.07 je Aktion bis 0.7).
    // Nov. 2026, Balance nach der Forschung: Organisationsarbeit wirkt in Europa auch dauerhaft (Pons, American Economic Review
    // 2018: Haustürwahlkampf für Hollande 2012 +3,2 Punkte in besuchten Bezirken, landesweit etwa ein Viertel des Vorsprungs,
    // noch 2014 messbar), aber nicht in der Größe, die 0.7 ergab (Linke +4 Punkte bis März 2029 gegenüber dem Grundspiel).
    // Jetzt +0.04 je Aktion bis 0.55. Frühere Kalibrierung mit sim.js zählte versehentlich den Debug-Schnellstart (SPD) mit.
    var LK_GAIN = Math.min(0.55, 0.35 + 0.04 * (Q.lk_orga || 0));
    if (Q.player == 'linke' && Q.lk_prev_support && !Q.spd_in_government) {
        for (var c of Q.classes) {
            var prev = Q.lk_prev_support[c];
            if (prev !== undefined && Q[c + '_spd'] > prev) {
                Q[c + '_spd'] = prev + LK_GAIN * (Q[c + '_spd'] - prev);
            }
        }
    }

    ////////////////////////// historische Schwerkraft, November 2024 - November 2026 (real bis heute)
    // Real monthly means of all institutes (state after the change into that month), order:
    // Union, AfD, SPD, Grüne, Linke, BSW, FDP, Sonstige. Sources: de.wikipedia.org/wiki/Bundestagswahl_2025/Umfragen_und_Prognosen
    // (Nov 2024 - Jan 2025; Linke computed from the single polls), official result of 23 Feb 2025 (Bundeswahlleiterin),
    // de.wikipedia.org/wiki/Wahl_zum_22._Deutschen_Bundestag/Umfragen_und_Prognosen (Mar 2025 - Nov 2026, tables
    // "Monatliche Mittelwerte"/"Ältere Mittelwerte", Stand 20.11.2026; November 2026 = 13 polls 2.-17.11.).
    // 2026: the page lists BSW only under Sonstige and the FDP only from May; estimated: FDP Jan-Apr 3.5,
    // BSW 3.4 (Jan-Apr) / 3.3 (from May), Sonstige = listed Sonstige minus these.
    // Each month every party moves by the real change of that month; the player's deviations stay.
    // From December 2026 on the future is open: Umfragetrend below (Durchgang 4.7).
    var GRAVITY = {
        '2024-11': [32.6, 18.1, 15.4, 11.3, 3.5, 6.6, 4.1, 8.4], '2024-12': [31.8, 18.8, 16.2, 12.7, 3.2, 6.2, 4.0, 7.1],
        '2025-1': [30.2, 20.5, 15.9, 13.5, 3.7, 5.4, 4.1, 6.7], '2025-2': [28.5, 20.8, 16.4, 11.6, 8.8, 5.0, 4.3, 4.6],
        '2025-3': [27.6, 22.3, 15.4, 11.7, 10.2, 4.3, 3.5, 5.0], '2025-4': [25.3, 24.5, 15.3, 11.4, 10.0, 4.2, 3.5, 5.8],
        '2025-5': [25.9, 24.1, 15.6, 11.3, 10.1, 3.9, 3.6, 5.5], '2025-6': [27.7, 23.2, 15.3, 11.4, 10.0, 3.9, 3.5, 5.0],
        '2025-7': [27.2, 24.0, 14.2, 11.4, 10.8, 4.0, 3.3, 5.1], '2025-8': [26.1, 24.9, 14.3, 11.4, 10.4, 4.0, 3.4, 5.5],
        '2025-9': [25.5, 25.6, 14.6, 11.3, 10.8, 3.8, 3.2, 5.2], '2025-10': [24.9, 25.9, 14.3, 11.4, 11.1, 4.0, 3.4, 5.0],
        '2025-11': [25.3, 25.9, 14.6, 11.6, 10.6, 3.7, 3.2, 5.1], '2025-12': [25.0, 25.9, 14.1, 11.6, 10.6, 3.7, 3.6, 5.5],
        '2026-1': [25.2, 25.7, 14.5, 11.9, 10.4, 3.4, 3.5, 5.4], '2026-2': [25.5, 24.8, 15.2, 11.7, 10.5, 3.4, 3.5, 5.4],
        '2026-3': [26.0, 24.7, 14.3, 12.8, 10.4, 3.4, 3.5, 4.9], '2026-4': [24.4, 26.4, 13.2, 13.4, 10.7, 3.4, 3.5, 5.0],
        '2026-5': [22.8, 27.6, 12.4, 14.1, 10.9, 3.3, 3.7, 5.3], '2026-6': [22.2, 27.9, 12.4, 14.0, 10.7, 3.3, 4.1, 5.4],
        '2026-7': [21.7, 27.6, 12.3, 13.9, 11.3, 3.3, 4.2, 5.6], '2026-8': [20.8, 28.1, 12.3, 14.3, 11.6, 3.3, 4.6, 5.1],
        '2026-9': [19.9, 28.2, 13.0, 14.7, 11.0, 3.3, 4.3, 5.6], '2026-10': [19.4, 28.5, 13.6, 14.9, 10.7, 3.3, 4.1, 5.5],
        '2026-11': [19.9, 27.7, 13.8, 15.4, 10.2, 3.3, 4.3, 5.4]
    };
    var prev_key = Q.month == 1 ? (Q.year - 1) + '-12' : Q.year + '-' + (Q.month - 1);
    var g_new = GRAVITY[Q.year + '-' + Q.month], g_old = GRAVITY[prev_key];
    // Q.poll_real: real values of this month per slot, shown next to ours in the poll tab (0 = open future)
    Q.poll_real = 0;
    if (g_new && g_old) {
        Q.poll_real = {};
        // the real Linke values pull slot spd when the Linke is played (and the SPD values slot linke)
        (Q.player == 'linke' ? ['union', 'afd', 'linke', 'gruene', 'spd', 'bsw', 'fdp', 'other'] : ['union', 'afd', 'spd', 'gruene', 'linke', 'bsw', 'fdp', 'other']).forEach(function(p, k) {
            Q.poll_real[p] = g_new[k];
            if (!Q.parties.includes(p)) return;
            var base = Math.max(0.5, 100 * (Q[p + '_normalized'] || 0));
            // scale the party in every group so that its total moves by the real change
            var f = Math.min(3, Math.max(0.3, (base + g_new[k] - g_old[k]) / base));
            for (var c of Q.classes) {
                Q[c + '_' + p] *= f;
            }
        });
    }
    ////////////////////////// Migration (Nov. 2026): wie wichtig das Thema ist und wie viele Menschen Asyl suchen
    // mig_sal: Anteil der Wahlberechtigten, die Zuwanderung/Flucht als wichtigstes oder zweitwichtigstes Problem nennen
    //   (ARD-DeutschlandTrend, infratest dimap, offene Frage mit zwei Nennungen): Juli 2025 33 %, November 2025 32 %,
    //   etwa Juni 2026 21 % (die Wirtschaft löste die Migration als wichtigstes Problem ab). November 2024 = 33 ist Annahme.
    // mig_asyl: Asylerstanträge aufs Jahr gerechnet in Tausend (BAMF): 2024 229.751, 2025 113.236, Januar–August 2026
    //   47.296 (≈ 71.000 im Jahr); Stützwerte jeweils zur Jahresmitte.
    // Bis November 2026 der reale Verlauf plus mig_dev (Abweichung durch Ereignisse und Spielzüge, klingt mit 8 % im Monat ab).
    // Danach: Grundlinie 10 + 0,15 je Tausend Erstanträge (ergibt im November 2026 die realen ~21 %), verdrängt durch hohe
    // Arbeitslosigkeit (ein Punkt je Prozentpunkt über 7 %); der Zugang kehrt mit 4 % im Monat zu 71.000 zurück.
    // Wirkung auf die Umfragen: Treiber „Migration“ im Umfragetrend unten.
    // Kampagneneffekt (15 %) und eigenes Profil als Juniorpartner (4 %) klingen jeden Monat ab (siehe oben und Umfragetrend)
    Q.kampagne = Math.round((Q.kampagne || 0) * 0.85 * 100) / 100;
    Q.profil = Math.round((Q.profil || 0) * 0.96 * 100) / 100;
    var tm = Q.year * 12 + Q.month, MM = function(y, m) { return y * 12 + m; };
    var lin = function(pts) {
        if (tm <= pts[0][0]) return pts[0][1];
        for (var i = 1; i < pts.length; i++) if (tm <= pts[i][0]) return pts[i - 1][1] + (pts[i][1] - pts[i - 1][1]) * (tm - pts[i - 1][0]) / (pts[i][0] - pts[i - 1][0]);
        return pts[pts.length - 1][1];
    };
    var mig_base;
    if (tm <= MM(2026, 11)) {
        Q.mig_asyl = Math.round(lin([[MM(2024, 7), 230], [MM(2025, 7), 113], [MM(2026, 5), 71]]));
        mig_base = lin([[MM(2024, 11), 33], [MM(2025, 7), 33], [MM(2025, 11), 32], [MM(2026, 6), 21], [MM(2026, 11), 20.5]]);
    } else {
        var asyl = Q.mig_asyl || 71;
        Q.mig_asyl = Math.round((asyl + 0.04 * (71 - asyl)) * 10) / 10;
        mig_base = 10 + 0.15 * Q.mig_asyl - Math.max(0, Q.unemployed - 7);
    }
    // Dänischer Kurs (SPD): Wer dauerhaft über Migration redet, hält das Thema oben (Gleichgewicht etwa +2,5 Punkte)
    if (Q.player != 'linke' && Q.neorevisionism >= 1) Q.mig_dev = (Q.mig_dev || 0) + 0.2;
    Q.mig_dev = Math.round((Q.mig_dev || 0) * 0.92 * 100) / 100;
    Q.mig_sal = Math.round(Math.max(5, Math.min(70, mig_base + Q.mig_dev)));

    ////////////////////////// Umfragetrend ab Dezember 2026 (Durchgang 4.7): die Zukunft ist offen
    // Instead of a fixed annual drift, explainable drivers move the national share of each party (pp per month).
    // Each party is then scaled in all voter groups like the gravity above, so the group structure stays.
    // Drivers: economy (unemployment, inflation, growth/real wages), wear in office, trust in democracy,
    // climate (gap to the 2030 target, energy prices), groups (right-wing mobilisation, social protest),
    // slow return to long-term camp strengths (AI parties only) and a little chance. Documented in PORT_2026.md
    // and in the library (Umfragen). Q.poll_why/Q.poll_trend: drivers of the last month for the poll tab.
    if (Q.year > 2026 || (Q.year == 2026 && Q.month == 12)) {
        var PT = Q.parties.filter(function(p) { return (Q[p + '_normalized'] || 0) > 0.002; });
        var sh = {}; PT.forEach(function(p) { sh[p] = 100 * Q[p + '_normalized']; });
        var has = function(p) { return PT.indexOf(p) >= 0; };
        var gov = PT.filter(function(p) { return Q[p + '_in_government']; });
        var CH = {'SPD': 'spd', 'Union': 'union', 'Grüne': 'gruene', 'Linke': 'linke', 'FDP': 'fdp', 'BSW': 'bsw', 'AfD': 'afd'}[Q.chancellor_party];
        if (CH && has(CH) && gov.indexOf(CH) < 0) gov.push(CH);
        var opp = PT.filter(function(p) { return gov.indexOf(p) < 0; });
        var not = function(list) { return PT.filter(function(p) { return list.indexOf(p) < 0; }); };
        var afd_opp = has('afd') && gov.indexOf('afd') < 0;
        var de = function(x) { return (+x).toFixed(1).replace('.', ',').replace('-', '−'); };
        var drv = [];
        // move `amount` pp from the parties `from` to the parties `to` (by share, or by the weights wto)
        // (wfrom: factors on the shares of the losing side, e.g. responsibility weights)
        var shift = function(text, amount, from, to, wto, wfrom) {
            from = from.filter(has); to = to.filter(has);
            if (!(amount > 0.002) || !from.length || !to.length) return;
            var d = {}, sf = 0, st = 0, wf = function(p) { return wfrom ? (wfrom[p] || 0) : 1; };
            from.forEach(function(p) { sf += sh[p] * wf(p); });
            to.forEach(function(p) { st += wto ? wto[p] : sh[p]; });
            if (!sf || !st) return;
            from.forEach(function(p) { d[p] = (d[p] || 0) - amount * sh[p] * wf(p) / sf; });
            to.forEach(function(p) { d[p] = (d[p] || 0) + amount * (wto ? wto[p] : sh[p]) / st; });
            drv.push([text, d]);
        };
        // Verantwortung (Nov. 2026): In Koalitionen bekommt die Kanzlerpartei überproportional Lob und Tadel für die Wirtschaft
        // (Duch/Stevenson, The Economic Vote 2008); die Partei des Finanzressorts teilt ihn, wenn ihre Zuständigkeit sichtbar ist
        // (Duch/Falcó-Gimeno 2021), im Spiel bei eigenem Investitionsprogramm oder Sondervermögen. Gewichte: Kanzlerpartei 2,
        // sichtbares Finanzressort 1,5, übrige Regierungsparteien 0,6.
        var SLOT = {'SPD': 'spd', 'Union': 'union', 'Grüne': 'gruene', 'Linke': 'linke', 'FDP': 'fdp', 'BSW': 'bsw', 'AfD': 'afd'};
        var FIN = SLOT[Q.finance_minister_party], resp = {}, wresp = {};
        gov.forEach(function(p) {
            resp[p] = p == CH ? 2 : (p == FIN && (Q.works_program > 0 || Q.sondervermoegen >= 1) ? 1.5 : 0.6);
            wresp[p] = sh[p] * resp[p];
        });
        // 1. economy: unemployment above 6.5 %, inflation above 2.5 %, growth below 1 % (real wages fall when prices outrun growth)
        var econ = Math.max(-3, Math.min(4, (Q.unemployed - 6.5) + 0.5 * Math.max(0, Q.inflation - 2.5) - 0.4 * ((Q.economic_growth || 0) - 1)));
        var etext = 'Wirtschaftslage (Arbeitslosigkeit ' + de(Q.unemployed) + ' %, Inflation ' + de(Q.inflation) + ' %, Wachstum ' + de(Q.economic_growth || 0) + ' %)';
        if (econ > 0) {
            // Unmut trifft die Regierung, die Opposition gewinnt nach ihrer Stärke (wirtschaftliches Wählen). Kein Extra für die
            // AfD (bis Nov. 2026: Faktor 1,5, „Protest wählt rechts“, „Kein Investitionsprogramm“ nur zur AfD): Nach normalen
            // Rezessionen legen Rechtsaußen-Parteien historisch nicht systematisch zu (Funke/Schularick/Trebesch, „Going to
            // extremes“, European Economic Review 2016), und die AfD-Sympathie erklärt sich vor allem aus Migrationssorgen,
            // kaum aus Einkommen, Bildung oder Job (SOEP 2014–2024, Schröder/Rehm/Röcke 2026). Spielannahme: Ohne
            // Investitionsprogramm wiegt der Unmut in einer tiefen Krise ein Viertel schwerer.
            shift(etext + ': Unmut über die Regierung', 0.04 * econ * (econ > 2 && !Q.works_program ? 1.25 : 1), gov, opp, undefined, resp);
        } else if (econ < 0) {
            shift(etext + ': Rückenwind für die Regierung', 0.04 * -econ, opp, gov, wresp);
        }
        // Finanzkrise: Nach systemischen Bankenkrisen gewinnen Rechtsaußen-Parteien in den fünf Jahren danach im Mittel rund
        // ein Drittel ihres Stimmenanteils hinzu (Funke/Schularick/Trebesch 2016: 20 Länder, über 800 Wahlen 1870–2014).
        // Im Spiel nach der Bankenkrise (banking_crisis_seen, Monat in sector_done): 60 Monate lang 0,55 % des AfD-Anteils im Monat.
        var bk = Q.sector_done && Q.sector_done.banking_crisis_seen;
        if (bk && afd_opp && Q.time - bk < 60) shift('Nach der Bankenkrise: Vertrauensverlust in die etablierten Parteien', 0.0055 * sh.afd, not(['afd']), ['afd']);
        // 2. Kosten des Regierens (bis Nov. 2026 nur die Kanzlerpartei, 0,02 im Monat): Regierungen verlieren im Mittel rund
        //    2¼ Punkte je Wahlperiode (Nannestad/Paldam 1999, 282 Wahlen in 19 Demokratien; spätere Schätzungen 1,6–2,5),
        //    ~0,047 im Monat, verteilt nach Stärke. Juniorpartner verlieren zusätzlich, weil ihr Profil neben der Kanzlerpartei
        //    verwischt (Klüver/Spoon, Journal of Politics 2020, 219 Wahlen in 28 Ländern: Oppositionsparteien schneiden in der
        //    Folgewahl rund 3 % besser ab): 0,06 % ihres Anteils im Monat (~3 % je Wahlperiode). Die Spielerpartei schützt sich mit
        //    eigenem Profil (Q.profil: sichtbare Erfolge bei Sozialstaat, Arbeit, Investitionen, offen ausgetragener Sachstreit;
        //    klingt mit 4 % im Monat ab, Monatswechsel oben); ab 3 Punkten entfällt der Zusatzverlust. KI-Juniorpartner: halb.
        if (gov.length) shift('Kosten des Regierens', 0.047, gov, opp);
        gov.filter(function(p) { return p != CH; }).forEach(function(p) {
            var prot = p == 'spd' ? Math.min(1, (Q.profil || 0) / 3) : 0.5;
            if (prot < 1) shift(p == 'spd' ? 'Juniorpartner ohne eigenes Profil' : 'Juniorpartner verliert Profil', 0.0006 * sh[p] * (1 - prot), [p], opp);
        });
        // 3. trust in democracy (pro_republic; the stronger effect on the AfD above remains)
        var dem = ['spd', 'union', 'gruene', 'fdp', 'linke', 'sapd', 'srpd'];
        if (afd_opp && Q.pro_republic < 45) shift('Geringes Vertrauen in die Demokratie (' + Math.round(Q.pro_republic) + ' %)', Math.min(0.06, 0.01 * (45 - Q.pro_republic) / 5), dem, ['afd']);
        if (afd_opp && Q.pro_republic > 60) shift('Hohes Vertrauen in die Demokratie (' + Math.round(Q.pro_republic) + ' %)', Math.min(0.04, 0.01 * (Q.pro_republic - 60) / 5), ['afd'], dem);
        // 4. climate: a large gap to the 2030 target helps the Greens in opposition and costs them in government
        var gap = Q.cl_gap2030 || 0;
        if (gap > 30 && has('gruene')) {
            if (gov.indexOf('gruene') < 0) shift('Klimaziel 2030 in Gefahr (Lücke ' + Math.round(gap) + ' Mio. t)', 0.02 * Math.min(1, (gap - 30) / 40) + (Q.klima_strength > 400 ? 0.01 : 0), not(['gruene']), ['gruene']);
            else shift('Klimaziel verfehlt trotz grüner Regierungsbeteiligung', 0.01, ['gruene'], opp);
        }
        // energy prices (index 2024 = 100): expensive energy feeds the AfD, cheap energy helps the government
        var epi = Q.energy_price || 100;
        if (epi > 105 && afd_opp) shift('Hohe Energiepreise (Index ' + Math.round(epi) + ')', Math.min(0.04, 0.01 * (epi - 105) / 5), gov.length ? gov : not(['afd']), ['afd']);
        if (epi < 95 && gov.length) shift('Günstige Energie (Index ' + Math.round(epi) + ')', 0.01, opp, gov);
        // Migration: Die Umfragewerte von Rechtsaußen-Parteien folgen eng der Bedeutung des Themas (Dennison/Geddes, „A Rising
        // Tide?“, Political Quarterly 2019, 15 westeuropäische Länder 2005–2018); Migrationssorgen erklären rund 75 % der
        // AfD-Sympathie (SOEP 2014–2024). Neutral bei 18–22 % (Niveau 2026). Steigung 0,006 Punkte je Prozentpunkt und Monat,
        // etwa halb so steil wie 2015/16 (Thema bei zeitweise über 80 %, AfD binnen eines Jahres von gut 4 auf über 10 %).
        var ms = Q.mig_sal || 22;
        if (afd_opp && ms > 22) shift('Migration als wichtiges Problem (' + Math.round(ms) + ' %)', Math.min(0.15, 0.006 * (ms - 22)), not(['afd']), ['afd']);
        if (afd_opp && ms < 18) shift('Migration im Hintergrund (' + Math.round(ms) + ' %)', Math.min(0.03, 0.006 * (18 - ms)), ['afd'], not(['afd']));
        // 5. groups: right-wing mobilisation (base 35) and social protest
        var grr = Q.g_rechts || 0;
        if (grr > 45 && afd_opp) shift('Starke rechte Mobilisierung', Math.min(0.04, 0.01 * (grr - 45) / 10 + 0.005), not(['afd']), ['afd']);
        if (grr < 25 && afd_opp) shift('Schwache rechte Mobilisierung', Math.min(0.03, 0.01 * (25 - grr) / 10 + 0.005), ['afd'], not(['afd']));
        if (Q.ga_vdk && Q.g_vdk > 70) shift('Sozialproteste', Math.min(0.03, 0.01 * (Q.g_vdk - 70) / 10), gov, ['spd', 'linke', 'sapd'].filter(function(p) { return gov.indexOf(p) < 0; }));
        // 6. slow return to long-term camp strengths (about the mean of the elections 2017-2025, scaled to 100),
        //    only for the AI parties: the player's own result stays the player's achievement.
        //    AfD 24 (bis Nov. 2026: 19): Mittel aus der Bundestagswahl 2025 (20,8 %) und dem Umfrageniveau seit Frühjahr 2025
        //    (25–29 %); die Wahlen 2017/2021 liegen vor ihrem Aufstieg zur stärksten Partei in den Umfragen.
        var LONG = {union: 28, afd: 24, gruene: 12, bsw: 3, fdp: 7, other: 5};
        LONG[Q.player == 'linke' ? 'linke' : 'spd'] = 19; LONG[Q.player == 'linke' ? 'spd' : 'linke'] = 7;
        var rev = {};
        PT.forEach(function(p) { if (p != 'spd' && LONG[p] !== undefined) rev[p] = 0.008 * (LONG[p] - sh[p]); });
        drv.push(['Langfristige Lagerstärken: Ausreißer bilden sich langsam zurück', rev]);
        // Wählerpotenzial der AfD: Laut Forsa (Güllner, Juni 2026) wollen 20 % der Wahlberechtigten die AfD wählen, weitere 8 %
        // können es sich vorstellen; das Potenzial sei „nahezu ausgeschöpft“. 28 % der Wahlberechtigten sind bei rund 80 %
        // Wahlbeteiligung etwa 35 % der Stimmen; nach einer Bankenkrise 38 % (siehe oben). Gewinne der AfD aus den Treibern
        // werden ab 28 % zunehmend gebremst, über dem Potenzial bröckelt die Zustimmung zurück (auch nach Ereignissen).
        if (has('afd')) {
            var pot = 35 + (bk ? 3 : 0), gain = 0;
            drv.forEach(function(x) { if ((x[1].afd || 0) > 0) gain += x[1].afd; });
            var brake = gain * Math.min(1, Math.max(0, (sh.afd - 28) / (pot - 28))) + 0.1 * Math.max(0, sh.afd - pot);
            shift('Wählerpotenzial der AfD weitgehend ausgeschöpft', brake, ['afd'], not(['afd']));
        }
        // 7. a little chance
        var rnd = {};
        PT.forEach(function(p) { rnd[p] = (Math.random() - 0.5) * 0.16 * Math.sqrt(sh[p] / 10); });
        drv.push(['Zufall', rnd]);
        var tot = {};
        drv.forEach(function(x) { for (var p in x[1]) tot[p] = (tot[p] || 0) + x[1][p]; });
        PT.forEach(function(p) {
            var dp = Math.max(-0.5, Math.min(0.5, tot[p] || 0));
            var f = Math.max(0.9, Math.min(1.1, (sh[p] + dp) / Math.max(0.5, sh[p])));
            for (var c of Q.classes) Q[c + '_' + p] *= f;
        });
        // the four strongest drivers (without chance) and the total per party, rounded, for the poll tab
        var size = function(x) { var s = 0; for (var p in x[1]) s += Math.abs(x[1][p]); return s; };
        Q.poll_why = drv.filter(function(x) { return x[0] != 'Zufall' && size(x) >= 0.02; }).sort(function(a, b) { return size(b) - size(a); }).slice(0, 4).map(function(x) {
            var parts = Object.keys(x[1]).filter(function(p) { return Math.abs(x[1][p]) >= 0.005; }).sort(function(a, b) { return x[1][b] - x[1][a]; });
            return {t: x[0], d: parts.map(function(p) { return [p, Math.round(x[1][p] * 100) / 100]; })};
        }).filter(function(x) { return x.d.length; });
        Q.poll_trend = {};
        PT.forEach(function(p) { Q.poll_trend[p] = Math.round((tot[p] || 0) * 100) / 100; });
    }
    if (Q.player == 'linke') {
        Q.lk_prev_support = {};
        for (var c of Q.classes) {
            Q.lk_prev_support[c] = Math.round(Q[c + '_spd'] * 100) / 100;
        }
    }
    // growth: 2024 -0.2 %, 2025 +0.2 % (Destatis; the US tariffs in events/zollstreit_2025 take another 0.2), forecast 2026 +0.8 %
    if (Q.year == 2025 && Q.month == 1) {
        Q.economic_growth += 0.6;
    }
    if (Q.year == 2026 && Q.month == 1) {
        Q.economic_growth += 0.6;
    }
    // EU: nationale Ausweichklausel für Verteidigungsausgaben, im Juli 2025 für 15 Staaten aktiviert, bis Februar 2026 für 18
    // einschließlich Deutschlands (Rat der EU, „European defence readiness“). Text in foreign_policy (young_plan_seen, Weimar-Name).
    if (Q.year * 12 + Q.month >= 2025 * 12 + 8) {
        Q.young_plan_seen = 1;
    }

    ////////////////////////// annual changes outside the polls
    // (until Durchgang 4.6 this block also held a fixed annual poll drift 2026-2029; replaced by the real
    //  monthly means up to November 2026 and the Umfragetrend above. Movements and unemployment stay.)
    if (Q.year == 2026 && Q.month > 1) {
        Q.rechts_strength += 10/12;
        Q.bauern_strength += 10/12;
        if (!Q.works_program) {
            Q.unemployed += 0.2/12;
        }
    } else if (Q.year == 2027) {
        Q.rechts_strength += 10/12;
        if (!Q.works_program) {
            Q.unemployed += 0.3/12;
            Q.rechts_strength += 10/12;
        }
    } else if (Q.year == 2028) {
        if (!Q.works_program) {
            Q.rechts_strength += 15/12;
        }
    }
    // prevent forever support if the economy is bad
    if (Q.year >= 2030 && (Q.inflation >= 5 || Q.unemployed >= 9) && Q.pro_republic <= 45 && Q.spd_in_government) {
        if (Q.workers_spd_normalized > 30) {
            Q.workers_spd -= 6/12;
        }
        if (Q.unemployed_spd_normalized > 15) {
            Q.unemployed_spd -= 6/12;
        }
        if (Q.new_middle_spd_normalized > 20) {
            Q.new_middle_spd -= 6/12;
        }
        if (Q.old_middle_spd_normalized > 15) {
            Q.old_middle_spd -= 6/12;
        }
        if (Q.rural_spd_normalized > 20) {
            Q.rural_spd -= 6/12;
        }
        if (Q.rentner_spd_normalized > 25) {
            Q.rentner_spd -= 6/12;
        }
    }
}
Q.pp_snap = {};
for (var c of Q.classes) Q.pp_snap[c] = Math.round((Q[c + '_spd'] || 0) * 1000) / 1000;
Q.has_event = 0;
// check if there are any cards in #event, and then go to main if not.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
} else {
    has_event = 0;
}
// pre-load all of the event images
if (this.ui && this.ui.show_portraits) {
    for (var choice of choices) {
        var cc = this.game.scenes[choice.id];
        if (cc.faceImage) {
            var im = new Image();
            im.url = cc.faceImage;
        }
    }
}

if (typeof window !== "undefined" && window.generateBar) {
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0 and (difficulty = 0 or difficulty = 1 or hand_size == 3); main.main_easy if has_event = 0 and (difficulty < 0 or hand_size == 4)

= [+ month : month +] [+ year +]

@events_choice

- #event

# This scene is solely for updating numbers after events, and routing to special events.
