title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;
// many events hand a ministry to another party without naming a minister: use that party's default then
var default_ministers = {
    'SPD': {foreign: 'Mützenich', interior: 'Fiedler', justice: 'Hubig', labor: 'Bas', bundeswehr: 'Pistorius', economic: 'Hubertz', finance: 'Klingbeil', agriculture: 'Miersch'},
    'Union': {foreign: 'Wadephul', interior: 'Dobrindt', justice: 'Krings', labor: 'Linnemann', bundeswehr: 'Kiesewetter', economic: 'Reiche', finance: 'Spahn', agriculture: 'Rainer'},
    'Grüne': {foreign: 'Brantner', interior: 'von Notz', justice: 'Haßelmann', labor: 'Banaszak', bundeswehr: 'Nouripour', economic: 'Dröge', finance: 'Kellner', agriculture: 'Özdemir'},
    'Linke': {foreign: 'van Aken', interior: 'Bartsch', justice: 'Bünger', labor: 'Reichinnek', bundeswehr: 'Pellmann', economic: 'Ramelow', finance: 'Görke', agriculture: 'Schwerdtner'},
    'FDP': {foreign: 'Lambsdorff', interior: 'Kubicki', justice: 'Kubicki', labor: 'Vogel', bundeswehr: 'Strack-Zimmermann', economic: 'Dürr', finance: 'Dürr', agriculture: 'Vogel'},
    'AfD': {interior: 'Chrupalla', justice: 'Brandner', agriculture: 'Protschka'}
};
// the keys are slot strings: when the Linke is played, slot 'SPD' holds the Linke and slot 'Linke' the SPD
// (events hard-code SPD names in slot 'SPD'; the check below replaces them by the Linke defaults)
if (Q.player == 'linke') {
    var t = default_ministers['SPD']; default_ministers['SPD'] = default_ministers['Linke']; default_ministers['Linke'] = t;
}
var real_spd = Q.player == 'linke' ? 'Linke' : 'SPD';
// ministers of the start cabinet (Scholz, November 2024) that are not default ministers
var minister_party_of = {'Frei': 'Union', 'Wissing': 'parteilos', 'Baerbock': 'Grüne', 'Habeck': 'Grüne',
                         'Faeser': real_spd, 'Kukies': real_spd, 'Heil': real_spd};
for (var mp in default_ministers) {
    for (var post in default_ministers[mp]) {
        minister_party_of[default_ministers[mp][post]] = mp;
    }
}
for (var post of ['foreign', 'interior', 'justice', 'labor', 'bundeswehr', 'economic', 'finance', 'agriculture']) {
    var holder = Q[post + '_minister'];
    var holder_party = Q[post + '_minister_party'];
    if (minister_party_of[holder] && minister_party_of[holder] != holder_party) {
        Q[post + '_minister'] = (default_ministers[holder_party] || {})[post] || 'N. N.';
    }
}
// make sure no stat is below 0.
for (var c of Q.classes) {
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
    }
}

Q.pro_republic = Math.round(Q.pro_republic);
Q.nationalism = Math.round(Q.nationalism);
Q.socialism = Math.round(Q.socialism);

if (Q.pro_republic < 0) {
    Q.pro_republic = 0;
}
if (Q.pro_republic >= 100) {
    Q.pro_republic = 99;
}
// re-calculate party support
// calculate normalized class voting for the achievements
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}
// calculate support for each of the parties
var total_support = 0; 
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) { 
            party_support += Q[c]*Q[c+'_'+party];
        } else  { 
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        } 
    }
    Q[party + '_support'] = party_support;
    total_support += party_support; 
}
// 2. normalize support (fraction)
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    Q[party+'_votes'] = Math.round(Q[party+'_normalized']*100);
    Q[party+'_votes_display'] = Math.round(Q[party+'_normalized']*100);
}


// set faction strength/dissent to 0
for (var c of Q.factions) {
    if (Q[c+'_dissent'] < 0) {
        Q[c+'_dissent'] = 0;
    } else if (Q[c+'_dissent'] >= 100) {
        Q[c+'_dissent'] = 99;
    }
    if (Q[c+'_strength'] < 0) {
        Q[c+'_strength'] = 0;
    }
}

if (Q.unemployed <= 1) {
    Q.unemployed = 1;
}

// re-calculate dissent.
var total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.neorevisionist_strength;

// normalize strength for the different factions
Q.left_strength = 100*Q.left_strength/total_strength;
Q.center_strength = 100*Q.center_strength/total_strength;
Q.labor_strength = 100*Q.labor_strength/total_strength;
Q.reformist_strength = 100*Q.reformist_strength/total_strength;
Q.neorevisionist_strength = 100*Q.neorevisionist_strength/total_strength;

var total_dissent = Q.left_strength*Q.left_dissent + Q.center_strength*Q.center_dissent + Q.labor_strength*Q.labor_dissent + Q.reformist_strength*Q.reformist_dissent + Q.neorevisionist_strength*Q.neorevisionist_dissent;


Q.dissent = 0.01*total_dissent/total_strength;
Q.dissent_percent = Q.dissent*100;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

////////////////////////// Wirtschaftssektoren (Durchgang 4.4, Reiter Wirtschaft)
// Bruttowertschöpfung 2024 in jeweiligen Preisen: 3 979,6 Mrd. Euro (Summe der Quartale; Destatis, Konjunkturindikatoren VGR,
// destatis.de/.../Volkswirtschaftliche-Gesamtrechnungen/vgr210.html, Stand 30.09.2026). Anteile daraus: Produzierendes Gewerbe
// ohne Bau 23,4 % (davon Verarbeitendes Gewerbe 19,9 %, destatis.de/Europa, Thema Industrie; Energie/Wasser/Bergbau als Rest 3,5 %),
// Baugewerbe 5,1 %, Handel/Verkehr/Gastgewerbe 16,3 %; Dienstleistungsbereiche zusammen 70,6 % (Statista nach Destatis), Land- und
// Forstwirtschaft als Rest 0,9 %. Die Aufteilung der übrigen Dienstleistungsbereiche ist geschätzt (Struktur der Vorjahre, auf 70,6 % abgestimmt).
// Startraten: reale Veränderung der Bruttowertschöpfung 2024 (Destatis, Pressemitteilung Nr. 017 vom 15.01.2026);
// Energie, Finanzen, Wohnungswesen und Landwirtschaft dort nicht ausgewiesen (geschätzt).
// Reihenfolge der Arrays sector_value/sector_growth/sector_why und der Records wie SECTORS (Namen und Texte: out/html/game.js, ECON_SECTORS).
var SECTORS = ['industrie', 'energie', 'bau', 'handel', 'ikt', 'finanzen', 'wohnen', 'dienste', 'oeffentlich', 'sonstige', 'agrar'];
if (!Q.sector_value || !Q.sector_value.length) {
    Q.sector_value = [19.9, 3.5, 5.1, 16.3, 4.9, 3.7, 10.6, 11.5, 19.7, 3.9, 0.9].map(function(s) { return Math.round(s * 39.796 * 10) / 10; });
    Q.sector_growth = [-4.3, -1.0, -3.8, 0.2, 2.1, 0.5, 0.5, 0.8, 1.2, 1.0, 0];
    Q.sector_records = [];
    Q.sector_why = SECTORS.map(function() { return ''; });
}

// 1. update dates
if (Q.month_actions >= 1) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.month += 1;
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
        if (Q.annual_income > 0) {
            Q.resources += Q.annual_income;
        }
    }
    // decrement timers
    for (timer of Q.timers) {
        if (Q[timer+'_timer'] && Q[timer+'_timer'] > 0) {
            Q[timer+'_timer'] -= 1;
        }
    }
    // append to historical party support records
    var party_support_results = {'date': new Date(Q.year, Q.month - 1)};
    for (var party of Q.parties) {
        party_support_results[party] = Q[party + '_normalized']*100;
        for (var c of Q.classes) {
            party_support_results[c + '_' + party] = Q[c + '_' + party + '_normalized'];
        }
    }
    Q.party_support_records.push(party_support_results);
    Q.economic_records.push({'date': new Date(Q.year, Q.month - 1),
                             'inflation': Math.round(Q.inflation * 100) / 100,
                             'unemployment': Math.round(Q.unemployed * 100) / 100,
                             'growth': Math.round((Q.economic_growth || 0) * 100) / 100,
                             'budget': Q.budget});

    // Sektoren: jede Branche hat eine eigene Jahresrate um das Gesamtwachstum (Grundtrend, Konjunkturempfindlichkeit BETA,
    // Politik und Ereignisse). Danach werden alle Raten so verschoben, dass ihr mit den Anteilen gewichtetes Mittel genau
    // economic_growth ist. Das Sektormodell wirkt nicht auf economic_growth und die Arbeitslosigkeit zurück (Balancing unverändert).
    // Schnittstelle für Ereignisse, Gruppen (4.5) und Klima (4.6): shock_<sektor> (Prozentpunkte Jahresrate, klingt mit 8 % im Monat ab),
    // energy_price (Index, 2024 = 100; teurere Energie bremst die Industrie).
    var g = Q.economic_growth || 0, cyc = g - 1;
    var TREND = [-0.8, 0.3, Q.year >= 2026 ? 0.3 : -1.5, 0, 2.0, 0, 0.2, 0.3, 0.8, 0, -0.5];
    var BETA = [1.7, 0.6, 1.4, 1.2, 0.8, 1.0, 0.3, 1.2, 0.2, 0.8, 0.3];
    var S = {}; SECTORS.forEach(function(s, i) { S[s] = i; });
    var pol = SECTORS.map(function() { return 0; }), why = SECTORS.map(function() { return []; });
    var add = function(s, v, text) { pol[S[s]] += v; why[S[s]].push(text); };
    // one-time shocks when an event happened first (Q.sector_done: flag -> month of the event)
    var ONE_TIME = [['industriekrise_seen', 'Industriekrise', {industrie: -2.5}],
                    ['zollstreit_2025_seen', 'US-Zölle 2025', {industrie: -1.5}],
                    ['black_thursday_seen', 'Zollkrieg', {industrie: -3, handel: -1.5, finanzen: -1}],
                    ['banking_crisis_seen', 'Bankenkrise', {finanzen: -4, bau: -1.5, wohnen: -1}],
                    ['capital_strike_seen', 'Investitionsstreik', {industrie: -3, bau: -2, dienste: -1.5}],
                    ['ukraine_ceasefire_seen', 'Waffenstillstand in der Ukraine', {industrie: 1, bau: 1, energie: 0.5}]];
    Q.sector_done = Q.sector_done || {};
    ONE_TIME.forEach(function(e) {
        if (!Q[e[0]]) return;
        if (Q.sector_done[e[0]] === undefined) {
            Q.sector_done[e[0]] = Q.time;
            for (var s in e[2]) Q['shock_' + s] = (Q['shock_' + s] || 0) + e[2][s];
        }
        if (Q.time - Q.sector_done[e[0]] < 18) {
            for (var s in e[2]) why[S[s]].push((e[2][s] < 0 ? 'Nachwirkung: ' : 'Auftrieb: ') + e[1]);
        }
    });
    if (Q.tariffs > 0) add('industrie', -0.6 * Math.min(Q.tariffs, 3), 'Zölle belasten den Export');
    if (Q.sondervermoegen == 2 && Q.year >= 2026) {
        add('bau', 1.0, 'Sondervermögen Infrastruktur');
        add('industrie', 0.3, 'Sondervermögen Infrastruktur');
    }
    if (Q.sondervermoegen >= 1 && Q.year >= 2026) add('industrie', 0.4, 'Rüstungsaufträge');
    if (Q.works_program > 0) {
        add('bau', 0.6 * Math.min(Q.works_program, 3), 'Investitionsoffensive');
        add('industrie', 0.2 * Math.min(Q.works_program, 3), 'Investitionsoffensive');
    }
    if (Q.bau_offensive > 0) {
        add('bau', 0.6 * Math.min(Q.bau_offensive, 2), 'Bau-Offensive im Wohnungsbau');
        add('wohnen', 0.2, 'Bau-Offensive im Wohnungsbau');
    }
    if (Q.welfare > 0) add('oeffentlich', 0.25 * Math.min(Q.welfare, 4), 'Ausbau des Sozialstaats');
    if (Q.science_bonus > 0) {
        add('ikt', 0.2 * Q.science_bonus, 'Forschung und Bildung');
        add('dienste', 0.05 * Q.science_bonus, 'Forschung und Bildung');
    }
    var ep = Q.energy_price || 100;
    if (Math.abs(ep - 100) >= 5) {
        add('industrie', -0.03 * (ep - 100), ep > 100 ? 'hohe Energiepreise' : 'günstigere Energie');
        add('energie', 0.01 * (ep - 100), ep > 100 ? 'hohe Energiepreise' : 'günstigere Energie');
    }
    if (Q.inflation > 4) add('handel', -0.5, 'hohe Inflation dämpft den Konsum');
    var rate = Q.sector_growth.map(function(r, i) {
        var shock = Q['shock_' + SECTORS[i]] || 0;
        if (shock && Math.abs(shock) < 0.05) shock = 0;
        Q['shock_' + SECTORS[i]] = Math.round(shock * 0.92 * 100) / 100;
        var target = Math.max(-15, Math.min(15, g + TREND[i] + (BETA[i] - 1) * cyc + pol[i] + shock));
        return r + 0.2 * (target - r);
    });
    var total = Q.sector_value.reduce(function(a, b) { return a + b; }, 0);
    var mean = rate.reduce(function(a, r, i) { return a + r * Q.sector_value[i] / total; }, 0);
    Q.sector_growth = rate.map(function(r) { return Math.round((r + g - mean) * 100) / 100; });
    Q.sector_value = Q.sector_value.map(function(v, i) { return Math.round(v * (1 + Q.sector_growth[i] / 1200) * 100) / 100; });
    Q.sector_why = why.map(function(a) { return a.join('; '); });
    Q.sector_records.push({'date': new Date(Q.year, Q.month - 1), 'v': Q.sector_value.map(function(v) { return Math.round(v * 10) / 10; })});
    // Interessengruppen und Bewegungen (Durchgang 4.5): Stärke, Konjunktur, Verhältnis, Druck auf Strömungen und Wählergruppen.
    // Tabelle, Treiber und Wirkungen: groups_data.scene.dry (GRP.month).
    if (!this.game.GRP) this._runActions(this.game.scenes.groups_data.onArrival);
    this.game.GRP.month(Q);
    // change economic stats...
    // we're basically implicity drawing a Philips curve, scaled to the German economy of the 2020s
    // budget deficits lead to some inflation
    if (Q.budget <= 0 && Q.budget > -2 && Q.inflation < 2.5) {
        Q.inflation += 0.1;
    }
    if (Q.budget <= -2 && Q.budget > -5 && Q.inflation < 4) {
        Q.inflation += 0.15;
        if (Q.unemployed >= 8) {
            Q.inflation -= 0.05;
        }
    }
    if (Q.budget <= -5 && Q.inflation < 8) {
        Q.inflation += 0.25;
        if (Q.unemployed >= 10) {
            Q.inflation -= 0.1;
        }
    }
    // deflation is bad
    if (Q.inflation < -0.5 && Q.inflation > -3 && Q.unemployed < 10) {
        Q.unemployed += 0.1;
    }
    if (Q.inflation <= -3 && Q.unemployed < 11) {
        Q.unemployed += 0.2;
    }
    // economic growth and unemployment
    // stagnation slowly pushes up unemployment (2023-2026: from 5.7% to 6.3%)
    if (Q.economic_growth < 0.5 && Q.unemployed <= 7) {
        Q.unemployed += 0.02;
    }
    if (Q.economic_growth < -0.5 && Q.unemployed <= 10) {
        Q.unemployed += 0.08;
    }
    if (Q.economic_growth < -3 && Q.unemployed <= 11) {
        Q.unemployed += 0.1;
    }
    if (Q.economic_growth >= 1.5 && Q.unemployed >= 5) {
        Q.unemployed -= 0.05;
    }
    if (Q.economic_growth >= 3 && Q.unemployed >= 4) {
        Q.unemployed -= 0.05;
    }
    if (Q.economic_growth >= 4.5 && Q.unemployed >= 3) {
        Q.unemployed -= 0.05;
    }
    if (Q.economic_growth >= 2 && Q.inflation >= 5) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= -2 && Q.inflation <= -3) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 3) {
        Q.economic_growth -= 0.1;
    }
    if (Q.economic_growth >= 5) {
        Q.economic_growth -= 0.2;
    }

    //////////////////////////////// Education & Science support/economic changes
    if (Q.major_curriculum && Q.major_curriculum == "Demokratiebildung") {
        if (Q.pro_republic < 65) {
            Q.pro_republic += 0.5;
        }
    }
    if (Q.minor_curriculum && Q.minor_curriculum == "Demokratiebildung") {
        if (Q.pro_republic < 65) {
            Q.pro_republic += 0.3;
        }
    }
    // science bonus to economic growth
    Q.science_bonus = 0;
    if (Q.education_science) {
        Q.science_bonus += Q.education_science;
    }
    if (Q.science) {
        if (Q.science >= 5) {
            Q.science_bonus += 3;
        } else if (Q.science >= 3) {
            Q.science_bonus += 2;
        } else if (Q.science >= 1) {
            Q.science_bonus += 1;
        }
    }
    if (Q.applied_research && Q.applied_research >= 1) {
        Q.science_bonus += 0.5*Q.applied_research;
    }
    // cap the science bonus at 6
    if (Q.science_bonus > 6) {
        Q.science_bonus = 6;
    }
    // more science -> higher levels of baseline growth (scaled: a bonus of 6 means about +3% baseline growth)
    if (Q.science_bonus >= 1) {
        if (Q.return_to_normalcy && Q.economic_growth < 1 + Q.science_bonus/2) {
            Q.economic_growth += 0.05;
        }
        if (Q.economic_growth < Q.science_bonus/2 - 1) {
            Q.economic_growth += 0.05;
        }
    }
    // accumulated economic growth/decline
    if (Q.economic_growth < 0) {
        if (Q.economic_expansion > 0) {
            Q.economic_expansion = 0;
        } else {
            Q.economic_expansion += Q.economic_growth;
        }
    }
    if (Q.economic_growth > 0 && Q.spd_in_government) {
        Q.economic_expansion += 1.5*Q.economic_growth;
    }
    /////////////////////////////// update opinions based on economy
    if (Q.unemployed > 8 && Q.pro_republic > 40) {
        Q.pro_republic -= 0.5;
    }
    if (Q.unemployed > 11 && Q.pro_republic > 20) {
        Q.pro_republic -= 1;
    }
    if (Q.inflation >= 5 && Q.pro_republic > 40) {
        Q.pro_republic -= 1;
    }

    ///////////////////////////// change party support based on pro_republic
    // if trust in democracy is lower than the support of the democratic center (SPD + Union + Grüne), voters drift to the AfD
    if (Q.pro_republic < (Q.spd_votes + Q.gruene_votes + Q.union_votes - 3)) {
        if (Q.new_middle_spd > 0) {
            Q.new_middle_spd -= 4/12;
            Q.new_middle_afd += 2/12;
        }
        if (Q.old_middle_spd > 0) {
            Q.old_middle_spd -= 4/12;
            Q.old_middle_afd += 3/12;
        }
        if (Q.rural_spd > 0) {
            Q.rural_spd -= 4/12;
            Q.rural_afd += 3/12;
        }
        if (Q.workers_spd_normalized > 10) {
            Q.workers_spd -= 4/12;
            Q.workers_afd += 3/12;
        }
        if (Q.rentner_spd > 0) {
            Q.rentner_spd -= 3/12;
        }
        if (Q.unemployed_spd_normalized > 8) {
            Q.unemployed_spd -= 4/12;
        }
        if (Q.old_middle_union > 0) {
            Q.old_middle_union -= 4/12;
            Q.old_middle_afd += 3/12;
        }
        if (Q.rural_union > 0) {
            Q.rural_union -= 4/12;
            Q.rural_afd += 3/12;
        }
        if (Q.workers_union > 0) {
            Q.workers_union -= 3/12;
            Q.workers_afd += 3/12;
        }
    }

    ////////////////////////// Linke game: less attention for a small opposition party (Durchgang 4.3)
    // In opposition, gains of the player slot since the last month change count only with LK_GAIN (losses fully).
    // Calibrated with node tools/sim.js . 60 linke (random play): 2025 election about 9.5 % of the votes / 11 % of the
    // seats (real 8.8 / 10.2), Dec 2025 and Nov 2026 about 12.5-13 % (real 10.6 / about 11). Without it: 10.8, 15.6, 17.2.
    var LK_GAIN = 0.4;
    if (Q.player == 'linke' && Q.lk_prev_support && !Q.spd_in_government) {
        for (var c of Q.classes) {
            var prev = Q.lk_prev_support[c];
            if (prev !== undefined && Q[c + '_spd'] > prev) {
                Q[c + '_spd'] = prev + LK_GAIN * (Q[c + '_spd'] - prev);
            }
        }
    }

    ////////////////////////// historische Schwerkraft, November 2024 - Januar 2026
    // Real monthly means of all institutes (state after the change into that month), order:
    // Union, AfD, SPD, Grüne, Linke, BSW, FDP, Sonstige. Sources: de.wikipedia.org/wiki/Bundestagswahl_2025/Umfragen_und_Prognosen
    // (Nov 2024 - Jan 2025; Linke computed from the single polls), official result of 23 Feb 2025 (Bundeswahlleiterin),
    // de.wikipedia.org/wiki/Wahl_zum_22._Deutschen_Bundestag/Umfragen_und_Prognosen (Mar - Dec 2025),
    // January 2026 = the calibrated start values of the original 2026 version.
    // Each month every party moves by the real change of that month; the player's deviations stay.
    var GRAVITY = {
        '2024-11': [32.6, 18.1, 15.4, 11.3, 3.5, 6.6, 4.1, 8.4], '2024-12': [31.8, 18.8, 16.2, 12.7, 3.2, 6.2, 4.0, 7.1],
        '2025-1': [30.2, 20.5, 15.9, 13.5, 3.7, 5.4, 4.1, 6.7], '2025-2': [28.5, 20.8, 16.4, 11.6, 8.8, 5.0, 4.3, 4.6],
        '2025-3': [27.6, 22.3, 15.4, 11.7, 10.2, 4.3, 3.5, 5.0], '2025-4': [25.3, 24.5, 15.3, 11.4, 10.0, 4.2, 3.5, 5.8],
        '2025-5': [25.9, 24.1, 15.6, 11.3, 10.1, 3.9, 3.6, 5.5], '2025-6': [27.7, 23.2, 15.3, 11.4, 10.0, 3.9, 3.5, 5.0],
        '2025-7': [27.2, 24.0, 14.2, 11.4, 10.8, 4.0, 3.3, 5.1], '2025-8': [26.1, 24.9, 14.3, 11.4, 10.4, 4.0, 3.4, 5.5],
        '2025-9': [25.5, 25.6, 14.6, 11.3, 10.8, 3.8, 3.2, 5.2], '2025-10': [24.9, 25.9, 14.3, 11.4, 11.1, 4.0, 3.4, 5.0],
        '2025-11': [25.3, 25.9, 14.6, 11.6, 10.6, 3.7, 3.2, 5.1], '2025-12': [25.0, 25.9, 14.1, 11.6, 10.6, 3.7, 3.6, 5.5],
        '2026-1': [26.1, 25.0, 15.3, 11.4, 9.5, 4.4, 4.2, 4.1]
    };
    var prev_key = Q.month == 1 ? (Q.year - 1) + '-12' : Q.year + '-' + (Q.month - 1);
    var g_new = GRAVITY[Q.year + '-' + Q.month], g_old = GRAVITY[prev_key];
    if (g_new && g_old) {
        // the real Linke values pull slot spd when the Linke is played (and the SPD values slot linke)
        (Q.player == 'linke' ? ['union', 'afd', 'linke', 'gruene', 'spd', 'bsw', 'fdp', 'other'] : ['union', 'afd', 'spd', 'gruene', 'linke', 'bsw', 'fdp', 'other']).forEach(function(p, k) {
            if (!Q.parties.includes(p)) return;
            var base = Math.max(0.5, 100 * (Q[p + '_normalized'] || 0));
            // scale the party in every group so that its total moves by the real change
            var f = Math.min(3, Math.max(0.3, (base + g_new[k] - g_old[k]) / base));
            for (var c of Q.classes) {
                Q[c + '_' + p] *= f;
            }
        });
    }
    if (Q.player == 'linke') {
        Q.lk_prev_support = {};
        for (var c of Q.classes) {
            Q.lk_prev_support[c] = Math.round(Q[c + '_spd'] * 100) / 100;
        }
    }
    // growth: 2024 -0.2 %, 2025 +0.2 % (Destatis; the US tariffs in events/zollstreit_2025 take another 0.2), forecast 2026 +0.8 %
    if (Q.year == 2025 && Q.month == 1) {
        Q.economic_growth += 0.6;
    }
    if (Q.year == 2026 && Q.month == 1) {
        Q.economic_growth += 0.6;
    }

    ////////////////////////// annual support changes
    // 2026: the Union loses heavily after broken promises (Schuldenbremse, Stromsteuer), the AfD and the Greens gain.
    // reference (average of all institutes): Jan 2026 Union 26, AfD 25, SPD 15, Grüne 11, Linke 10
    //                                         Nov 2026 Union 20, AfD 28, SPD 14, Grüne 15, Linke 10
    // (from February on: January 2026 is still covered by the gravity table above)
    // the real SPD and Linke sit in swapped slots when the Linke is played
    var SPD = Q.player == 'linke' ? 'linke' : 'spd', LINKE = Q.player == 'linke' ? 'spd' : 'linke';
    if (Q.year == 2026 && Q.month > 1) {
        Q.rentner_union -= 7/12;
        Q.workers_union -= 6/12;
        Q.new_middle_union -= 6/12;
        Q.old_middle_union -= 6/12;
        Q.rural_union -= 5/12;
        Q.workers_afd += 4/12;
        Q.rural_afd += 4/12;
        Q.old_middle_afd += 3/12;
        Q.unemployed_afd += 2/12;
        Q.rentner_afd += 3/12;
        Q.new_middle_gruene += 6/12;
        Q.rentner_gruene += 3/12;
        Q.old_middle_gruene += 3/12;
        Q.workers_bsw -= 1/12;
        Q.unemployed_bsw -= 1/12;
        Q.rechts_strength += 10/12;
        Q.bauern_strength += 10/12;
        if (!Q.works_program) {
            Q['workers_' + SPD] -= 2/12;
            Q['rentner_' + SPD] -= 2/12;
            Q.workers_afd += 1/12;
            Q.unemployed += 0.2/12;
        }
    } else if (Q.year == 2027) {
        // the Union stabilizes somewhat; the AfD keeps growing in a stagnating economy
        Q.rentner_union += 2/12;
        Q.old_middle_union += 2/12;
        Q.workers_afd += 2/12;
        Q.rural_afd += 2/12;
        Q.rechts_strength += 10/12;
        if (!Q.works_program) {
            Q.workers_afd += 3/12;
            Q.unemployed_afd += 3/12;
            Q.old_middle_afd += 2/12;
            Q['workers_' + LINKE] += 2/12;
            Q['workers_' + SPD] -= 2/12;
            Q.unemployed += 0.3/12;
            Q.rechts_strength += 10/12;
        } else if (Q.unemployed > 7) {
            Q.workers_afd += 2/12;
            Q.unemployed_afd += 2/12;
        }
    } else if (Q.year == 2028) {
        Q.old_middle_other -= 2/12;
        Q.rural_other -= 2/12;
        Q.old_middle_afd += 2/12;
        Q.rural_afd += 2/12;
        if (!Q.works_program) {
            Q.workers_afd += 3/12;
            Q.unemployed_afd += 3/12;
            Q.rural_afd += 3/12;
            Q.new_middle_afd += 2/12;
            Q['workers_' + LINKE] += 2/12;
            Q['unemployed_' + LINKE] += 2/12;
            Q.rechts_strength += 15/12;
        } else if (Q.unemployed > 8) {
            Q.rural_afd += 2/12;
            Q.unemployed_afd += 2/12;
            Q.old_middle_afd += 2/12;
        }
    } else if (Q.year >= 2029) {
        if (Q.return_to_normalcy) {
            // a stable economy brings voters back to their traditional parties
            if (Q.new_middle_gruene_normalized < 25) {
                Q.new_middle_gruene += 3/12;
            }
            if (Q.old_middle_fdp_normalized < 10) {
                Q.old_middle_fdp += 2/12;
            }
            if (Q.old_middle_union_normalized < 35) {
                Q.old_middle_union += 4/12;
            }
            if (Q.rentner_union_normalized < 38) {
                Q.rentner_union += 4/12;
            }
            if (Q.workers_spd_normalized < 25) {
                Q.workers_spd += 3/12;
            }
        }
        if (Q.unemployed > 9) {
            Q.rural_afd += 2/12;
            Q.unemployed_afd += 2/12;
            Q.old_middle_afd += 2/12;
            Q.new_middle_afd += 2/12;
            if (Q.spd_in_government) {
                Q.workers_spd -= 4/12;
            }
        }
    }
    // prevent forever support if the economy is bad
    if (Q.year >= 2030 && (Q.inflation >= 5 || Q.unemployed >= 9) && Q.pro_republic <= 45 && Q.spd_in_government) {
        if (Q.workers_spd_normalized > 30) {
            Q.workers_spd -= 6/12;
        }
        if (Q.unemployed_spd_normalized > 15) {
            Q.unemployed_spd -= 6/12;
        }
        if (Q.new_middle_spd_normalized > 20) {
            Q.new_middle_spd -= 6/12;
        }
        if (Q.old_middle_spd_normalized > 15) {
            Q.old_middle_spd -= 6/12;
        }
        if (Q.rural_spd_normalized > 20) {
            Q.rural_spd -= 6/12;
        }
        if (Q.rentner_spd_normalized > 25) {
            Q.rentner_spd -= 6/12;
        }
    }
}
Q.has_event = 0;
// check if there are any cards in #event, and then go to main if not.
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
} else {
    has_event = 0;
}
// pre-load all of the event images
if (this.ui && this.ui.show_portraits) {
    for (var choice of choices) {
        var cc = this.game.scenes[choice.id];
        if (cc.faceImage) {
            var im = new Image();
            im.url = cc.faceImage;
        }
    }
}

if (typeof window !== "undefined" && window.generateBar) {
}
!}
go-to: events_choice if has_event = 1; main if has_event = 0 and (difficulty = 0 or difficulty = 1 or hand_size == 3); main.main_easy if has_event = 0 and (difficulty < 0 or hand_size == 4)

= [+ month : month +] [+ year +]

@events_choice

- #event

# This scene is solely for updating numbers after events, and routing to special events.
