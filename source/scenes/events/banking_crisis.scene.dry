title: Bankenkrise
subtitle: Das deutsche Bankensystem wankt …
new-page: true
on-arrival: banking_crisis_seen = 1; workers_linke += 5; workers_afd += 3; new_middle_afd += 3; old_middle_afd += 4; rural_afd += 3; unemployed += 1.5; crisis_urgency += 1; workers_spd -= 4 if spd_in_government; new_middle_spd -= 5 if spd_in_government; old_middle_spd -= 5 if spd_in_government; rural_spd -= 4 if spd_in_government; economic_growth -= 1;
