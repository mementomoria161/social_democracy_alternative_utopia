title: Bundestagswahl
new-page: true
tags: event
priority: -1
view-if: (year = next_election_year and month >= next_election_month) or (year > next_election_year)
on-departure: month_actions += 1; in_election = 0; next_election_year = year + 4; next_election_month = month; n_elections += 1; next_election_time = time + 48; last_election_time = time; election_scheduled = 1; bundestag_dissolved = 0; bundestag_seats = 630;
set-jump: post_election
face-image: img/bundestagswahl.jpg

# the low priority means that this event is only seen after all other events are resolved for the month.

= Bundestagswahl, [+ month : month +] [+ year +]

Heute wird der Bundestag gewählt. Die Wahllokale schließen um 18 Uhr, dann kommen die ersten Prognosen.[? if n_elections = 0 and player = "linke" and spd_candidate = "Reichinnek" : Für die Linke treten Heidi Reichinnek und Jan van Aken als Spitzenduo an. ?][? if n_elections = 0 and player = "linke" and spd_candidate = "Gysi" : Für die Linke führt Gregor Gysi die Liste an. ?][? if n_elections = 0 and player = "linke" and spd_candidate = "Schwerdtner" : Für die Linke treten die Vorsitzenden Ines Schwerdtner und Jan van Aken an. ?][? if n_elections = 0 and player = "linke" : Ob die Partei wieder in den Bundestag einzieht, entscheidet sich an der Fünf-Prozent-Hürde und in einer Handvoll Wahlkreise: Mit drei Direktmandaten zöge sie in Stärke ihres Zweitstimmenergebnisses ein. Für die SPD kämpft Olaf Scholz um das Kanzleramt, für die Union Friedrich Merz. Zum ersten Mal gilt das neue Wahlrecht: Der Bundestag schrumpft von 733 auf 630 Sitze. ?][? if n_elections = 0 and player = "spd" : Für die SPD tritt [+ spd_candidate +] als Kanzlerkandidat an, für die Union Friedrich Merz, für die Grünen Robert Habeck, für die AfD Alice Weidel. Zum ersten Mal gilt das neue Wahlrecht: Der Bundestag schrumpft von 733 auf 630 Sitze. ?]

- @election_algorithm: Wir haben getan, was wir konnten.

@post_election
on-arrival: {!
// 5% threshold (Sperrklausel): parties below it and "Sonstige" get no seats.
// Banned parties get no seats.
var new_party_sum = 0;
var all_parties = Q.parties.slice();
if (Q.sapd_formed) {
    all_parties.push('sapd');
}
// Grundmandatsklausel (Paragraph 4 BWahlG, kept by the BVerfG on 30.07.2024): three direct mandates carry a party
// below 5 % into the Bundestag with its full second-vote share. Player slot as Linke: direct_mandates (raised by
// "Silberlocke" and other campaigns); otherwise a simple rule: the CSU is part of the Union, the SPD always holds
// Wahlkreise, the Linke from 3 % on (Berlin-Ost, Leipzig), the AfD from 3 % on (in the East).
Q.grundmandat = 0;
var grund = function(party, votes) {
    if (party == 'spd') return Q.player == 'linke' ? (Q.direct_mandates || 0) >= 3 : votes >= 2;
    if (party == 'linke') return Q.player == 'linke' ? votes >= 2 : votes >= 3;
    if (party == 'union') return true;
    if (party == 'afd') return votes >= 3;
    return false;
};
for (var party of all_parties) {
    Q['old_' + party + '_r'] = Q[party + '_r'] || 0;
    var votes = Q[party + '_votes_dec'] || Q[party + '_votes'] || 0;
    var below = votes < Q.electoral_threshold && !(votes > 0 && grund(party, votes));
    if (party == 'spd' && votes < Q.electoral_threshold && !below) Q.grundmandat = 1;
    if (below || party == 'other' || Q[party + '_banned']) {
        Q[party + '_r'] = 0;
    } else {
        Q[party + '_r'] = votes;
    }
    new_party_sum += Q[party + '_r'];
}
for (var party of all_parties) {
    if (Q[party + '_r'] > 0) {
        Q[party + '_r'] = Math.round(Q[party + '_r']*1000/new_party_sum)/10;
    }
    Q[party + '_r_disp'] = Q[party + '_r'].toFixed(1);
    var change = Math.round((Q[party + '_r'] - Q['old_' + party + '_r'])*10)/10;
    Q['change_' + party + '_r'] = change;
    Q['str_change_' + party] = (change > 0 ? '+' : '') + change.toFixed(1);
    // vote share (not seat share) for the results table
    Q[party + '_vote_disp'] = Number(Q[party + '_votes_dec'] || Q[party + '_votes'] || 0).toFixed(1);
}

// largest party
Q.largest_party = Q.pp_name || 'SPD';
var names = {'spd': Q.pp_name || 'SPD', 'linke': Q.op_name || 'Linke', 'union': 'Union', 'gruene': 'Grüne', 'fdp': 'FDP', 'bsw': 'BSW', 'afd': 'AfD', 'other': 'Sonstige', 'sapd': 'Soziale Linke'};
var max_r = -1;
for (var party of all_parties) {
    if (Q[party + '_r'] > max_r) {
        max_r = Q[party + '_r'];
        Q.largest_party = names[party];
    }
}
// Bundestagspräsidium: by custom the strongest group except the AfD (whose candidates fail) provides the president
// after the first election of the game the SPD would keep Bärbel Bas in office
var btp_spd = Q.n_elections <= 1 ? 'Bas' : 'Ortleb';
var btp_candidates = {'union': 'Klöckner', 'spd': Q.player == 'linke' ? 'Ramelow' : btp_spd, 'gruene': 'Nouripour', 'linke': Q.player == 'linke' ? btp_spd : 'Ramelow'};
var btp_party = null;
for (var party of all_parties) {
    if (party != 'afd' && (btp_party === null || Q[party + '_r'] > Q[btp_party + '_r'])) {
        btp_party = party;
    }
}
if (btp_candidates[btp_party]) {
    Q.bundestag_president = btp_candidates[btp_party];
}

var sapd = Q.sapd_formed ? (Q.sapd_r || 0) : 0;
var srpd = Q.srpd_r || 0;
// coalitions (in % of seats)
// Schwarz-Rot
Q.grand_coalition = Q.spd_r + Q.union_r + srpd;
// Kenia
Q.weimar_coalition = Q.spd_r + Q.union_r + Q.gruene_r + srpd;
// Ampel
Q.ampel_coalition = Q.fdp_r > 0 ? Q.spd_r + Q.gruene_r + Q.fdp_r + srpd : 0;
// Rot-Grün
Q.rotgruen_coalition = Q.spd_r + Q.gruene_r + srpd;
// Rot-Grün-Rot
Q.popular_front_coalition = Q.spd_r + Q.gruene_r + Q.linke_r + sapd + srpd;
// Rot-Rot
Q.left_coalition = Q.spd_r + Q.linke_r + sapd;
// all democratic parties of the center (without Linke, BSW, AfD)
Q.neo_weimar_coalition = Q.spd_r + Q.union_r + Q.gruene_r + Q.fdp_r + srpd;
// coalitions without the SPD
Q.schwarz_gruen_coalition = Q.union_r + Q.gruene_r;
Q.bourgeois_coalition = Q.union_r + Q.gruene_r + Q.fdp_r;
Q.right_coalition = Q.union_r + Q.fdp_r;
// AfD + BSW
Q.far_right_coalition = Q.afd_r + Q.bsw_r;
Q.anti_democratic_coalition = Q.afd_r + Q.bsw_r;
// Union + AfD (the "Brandmauer" falls)
Q.hitler_right_coalition = Q.union_r + Q.afd_r;
// SPD + Grüne + Linke: needed for progressive social reforms
Q.progressive_coalition = Q.spd_r + Q.linke_r + Q.gruene_r + sapd;
// coalitions of the other parties when the Linke is played (slot linke = SPD)
Q.union_spd_coalition = Q.union_r + Q.linke_r;
Q.spd_gruene_coalition = Q.linke_r + Q.gruene_r;

Q.leverage = Math.round(Q.spd_r);

Q.grand_coalition_failed = 0;
// first election (prolog): the old government stays in office until the Kanzlerwahl (events/kanzlerwahl_2025);
// the Regierungs-Reiter shows this snapshot as the caretaker government until then (display only; at most 4 months
// after the last election, e.g. when a second election follows and the Kanzlerwahl event does not come)
if (!Q.gf_gov && !Q.kanzlerwahl_seen && Q.year <= 2025) {
    Q.gf_gov = {chancellor: Q.chancellor, chancellor_party: Q.chancellor_party, coalition_name: Q.coalition_name};
    for (var post of ['foreign', 'interior', 'justice', 'labor', 'bundeswehr', 'economic', 'finance', 'agriculture']) {
        Q.gf_gov[post + '_minister'] = Q[post + '_minister'];
        Q.gf_gov[post + '_minister_party'] = Q[post + '_minister_party'];
    }
}
// reset the government
Q.coalition_dissent = 0;
Q.linke_coalition_dissent = 0;
Q.spd_in_government = 0;
Q.union_in_government = 0;
Q.gruene_in_government = 0;
Q.fdp_in_government = 0;
Q.linke_in_government = 0;
Q.bsw_in_government = 0;
Q.afd_in_government = 0;
Q.in_weimar_coalition = 0;
Q.in_grand_coalition = 0;
Q.in_left_front = 0;
Q.in_popular_front = 0;
Q.in_right_coalition = 0;
Q.in_emergency_government = 0;
Q.in_minority_government = 0;
Q.in_unity_government = 0;
Q.spd_toleration = 0;
Q.spd_caretaker = 0;
Q.coalition_name = "keine";
Q.partner_party = "Union";

// reset Linke goals
Q.linke_goals_seen = 0;
Q.linke_ultimatum_seen = 0;
Q.welfare_goal = 0;
Q.agriculture_goal = 0;
Q.economy_goal = 0;
Q.finance_goal = 0;
Q.labor_goal = 0;
Q.foreign_goal = 0;
Q.interior_goal = 0;
Q.bundeswehr_goal = 0;

Q.welfare_goal_completed = 0;
Q.agriculture_goal_completed = 0;
Q.economy_goal_completed = 0;
Q.finance_goal_completed = 0;
Q.labor_goal_completed = 0;
Q.foreign_goal_completed = 0;
Q.interior_goal_completed = 0;
Q.bundeswehr_goal_completed = 0;

Q.strike_term_seen = 0;

if (Q.afd_r >= 25) {
    Q.understanding_enemy_timer = 2;
}

var election_result = {'date': new Date(Q.year, Q.month - 1)};
for (var party of Q.parties) {
    election_result[party] = Q[party + '_r'];
}
Q.election_records.push(election_result);
!}
on-departure: nazi_urgency = 3 if (nazi_urgency < 3 and afd_r >= 25)
on-display: {!
var data = [
    {"id": "linke", "legend": Q.op_name || "Linke", "name": Q.op_name || "Linke", "seats": Math.round(Q.linke_r*6.3)}
];
if (Q.sapd_formed && Q.sapd_r) {
    data.push({"id": "sapd", "legend": "Soziale Linke", "name": "Soziale Linke", "seats": Math.round(Q.sapd_r*6.3)});
}
data.push({"id": "spd", "legend": Q.pp_name || "SPD", "name": Q.pp_name || "SPD", "seats": Math.round(Q.spd_r*6.3)});
if (Q.srpd_formed && Q.srpd_r) {
    data.push({"id": "srpd", "legend": "SRPD", "name": "SRPD", "seats": Math.round(Q.srpd_r*6.3)});
}
data = data.concat([
    {"id": "gruene", "legend": Q.gruene_name, "name": Q.gruene_name, "seats": Math.round(Q.gruene_r*6.3)},
    {"id": "bsw", "legend": "BSW", "name": "BSW", "seats": Math.round(Q.bsw_r*6.3)},
    {"id": "fdp", "legend": "FDP", "name": "FDP", "seats": Math.round(Q.fdp_r*6.3)},
    {"id": "union", "legend": "CDU/CSU", "name": "CDU/CSU", "seats": Math.round(Q.union_r*6.3)},
    {"id": "afd", "legend": "AfD", "name": "AfD", "seats": Math.round(Q.afd_r*6.3)},
]);

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = Math.max(200, screenWidth - 50); // the content can be hidden (width 0) while the scene is built
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    }

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);
}
!}
go-to: coalition_menu

= Wahlergebnis

{!<svg id="reichstag" style="width: 500px; height: 250px;"> </svg>!}

{!<table>!}
{!<tr><td>Partei</td><td>Stimmen</td><td>Sitzanteil</td><td>Veränderung</td></tr>!}
[? if player = "spd" : {!<tr><td><div class="box" style='background-color:#E3000F; outline: 2px; outline-style: solid;'> </div> !} ?][? if player = "linke" : {!<tr><td><div class="box" style='background-color:#BE3075; outline: 2px; outline-style: solid;'> </div> !} ?] **[+ pp_name +]:** {!</td><td>!} **[+ spd_vote_disp +]%** {!</td><td>!} **[+ spd_r_disp +]%** {!</td><td>!} **[+ str_change_spd +]** {!</td></tr>!}

[? if sapd_formed : {!<tr><td><div class="box" style='background-color:#C40000'> </div> !}Soziale Linke: {!</td><td>!} [+ sapd_vote_disp +]% {!</td><td>!} [+ sapd_r_disp +]% {!</td><td>!} [+ str_change_sapd +] {!</td></tr>!} ?]

{!<tr><td><div class="box" style='background-color:#151518'> </div> !} CDU/CSU: {!</td><td>!} [+ union_vote_disp +]% {!</td><td>!} [+ union_r_disp +]% {!</td><td>!} [+ str_change_union +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#009EE0'> </div> !} AfD: {!</td><td>!} [+ afd_vote_disp +]% {!</td><td>!} [+ afd_r_disp +]% {!</td><td>!} [+ str_change_afd +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#46962B'> </div> !} [+ gruene_name +]: {!</td><td>!} [+ gruene_vote_disp +]% {!</td><td>!} [+ gruene_r_disp +]% {!</td><td>!} [+ str_change_gruene +] {!</td></tr>!}

[? if player = "spd" : {!<tr><td><div class="box" style='background-color:#BE3075'> </div> !} ?][? if player = "linke" : {!<tr><td><div class="box" style='background-color:#E3000F'> </div> !} ?] [+ op_name +]: {!</td><td>!} [+ linke_vote_disp +]% {!</td><td>!} [+ linke_r_disp +]% {!</td><td>!} [+ str_change_linke +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#FFED00'> </div> !} FDP: {!</td><td>!} [+ fdp_vote_disp +]% {!</td><td>!} [+ fdp_r_disp +]% {!</td><td>!} [+ str_change_fdp +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#7D254F'> </div> !} BSW: {!</td><td>!} [+ bsw_vote_disp +]% {!</td><td>!} [+ bsw_r_disp +]% {!</td><td>!} [+ str_change_bsw +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#a0a0a0'> </div> !} Sonstige: {!</td><td>!} [+ other_vote_disp +]% {!</td><td>!} – {!</td><td>!} {!</td></tr>!}
{!</table>!}

Parteien unter fünf Prozent ziehen nicht in den Bundestag ein, außer sie gewinnen mindestens drei Wahlkreise direkt. [? if grundmandat : Wir bleiben unter fünf Prozent, aber unsere Direktmandate tragen uns über die Grundmandatsklausel in den Bundestag: Wir ziehen in Stärke unseres Zweitstimmenergebnisses ein. ?][? if spd_r = 0 : Wir haben den Einzug in den Bundestag verpasst. ?] Stärkste Kraft: **[+ largest_party +]**.

**Mögliche Koalitionen (Sitzanteil):**

[? if player = "spd" : Schwarz-Rot (Union + SPD): [+ grand_coalition +]% ?][? if player = "linke" : Schwarz-Rot (Union + SPD): [+ union_spd_coalition +]% ?]

[? if player = "spd" : Kenia (Union + SPD + Grüne): [+ weimar_coalition +]% ?][? if player = "linke" : Rot-Grün (SPD + Grüne): [+ spd_gruene_coalition +]% ?]

[? if fdp_r > 0 and player = "spd" : Ampel (SPD + Grüne + FDP): [+ ampel_coalition +]% ?]

Rot-Grün-Rot (SPD + Grüne + Linke): [+ popular_front_coalition +]%

[? if player = "linke" : Rot-Rot (SPD + Linke): [+ left_coalition +]% ?]

Schwarz-Grün (Union + Grüne): [+ schwarz_gruen_coalition +]%

[? if fdp_r > 0 : Schwarz-Gelb (Union + FDP): [+ right_coalition +]% ?]

[? if nazi_urgency < 3 and afd_r >= 25 : Das Ergebnis der AfD ist ein Schock. Ein Viertel des Parlaments gehört nun einer Partei, die der Verfassungsschutz in Teilen als gesichert rechtsextrem einstuft. ?]

[? if hitler_right_coalition >= 50 : Union und AfD hätten zusammen eine Mehrheit. Alles hängt davon ab, ob die Brandmauer hält. ?]

[? if anti_democratic_coalition >= 34 : AfD und BSW verfügen zusammen über eine Sperrminorität: Ohne sie sind keine Grundgesetzänderungen mehr möglich. ?]

Die Sondierungen beginnen.

