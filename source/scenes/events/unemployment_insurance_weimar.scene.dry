new-page: true
view-if: spd_in_government = 1 and (year = 2026 or year = 2027 or year = 2028) and month == 3 and (spd_in_government and (in_grand_coalition = 0 or chancellor_party == "SPD")) and unemployment_insurance_timer = 0 and unemployed >= unemployment_insurance_threshold + 2
on-arrival: unemployment_insurance_crisis += 1; budget -= 1 if budget >= 1; unemployment_insurance_timer = 8; crisis_urgency += 1; unemployment_insurance_threshold = unemployed
