title: Die Vertrauensfrage
subtitle: Der Kanzler stellt sie, um sie zu verlieren.
new-page: true
tags: event
view-if: vertrauensfrage_seen = 0 and ampel_aus_seen = 1 and n_elections = 0 and year = vf_year and month = vf_month
max-visits: 1
priority: 0
on-arrival: vertrauensfrage_seen = 1; bundestag_dissolved = 1
