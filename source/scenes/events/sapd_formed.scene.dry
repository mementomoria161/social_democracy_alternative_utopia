on-arrival: {!
// set up the infrastructure
Q.sapd_formed = 1;
Q.parties.push('sapd');

// Nach der Abspaltung der Parteilinken allein (left_split) eine kleine Partei; mit den Funktionär*innen der Parteimitte
// (centrists_resign, vorher oder später, dann in centrist_leaders_resign) die ernsthafte Konkurrenz aus dem Ereignistext.
Q.workers_sapd = 6;
Q.new_middle_sapd = 1;
Q.old_middle_sapd = 0;
Q.rural_sapd = 0;
Q.unemployed_sapd = 1;
Q.rentner_sapd = 0;
if (Q.centrists_resign) {
    Q.workers_sapd += 4;
    Q.unemployed_sapd += 1;
    Q.workers_spd -= 4;
}

Q.workers_other -= 5;

if (Q.unions_independent) {
    Q.workers_sapd += 8;
}

// update all records
Q.sapd_r = 0;
Q.old_sapd_r = 0;
for (var record of Q.election_records) {
    record['sapd'] = 0;
}
for (var record of Q.party_support_records) {
    record['sapd'] = 0;
}
!}
