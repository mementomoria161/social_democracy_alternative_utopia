@round2_thalmann_2
on-arrival: schwesig_campaign = 0; spd_support_thalmann = 1; reformist_dissent += 15; center_dissent += 10; labor_dissent += 5; neorevisionist_dissent += 10; rentner_spd -= 5; workers_spd -= 3; linke_relation += 10; communist_coalition += 2; union_relation -= 15; fdp_relation -= 15
