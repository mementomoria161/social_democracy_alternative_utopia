@round2_convince_union
view-if: schwesig_campaign > 0 and union_support_schwesig != 1 
choose-if: spd_votes >= union_votes
unavailable-subtitle: Die Union weiß, dass sie stärker ist als wir, und sieht keinen Grund, unsere Kandidatin zu unterstützen.
on-arrival: {!
Q.union_support_schwesig = 0;
// if Hindenburg (Lammert) support is greater than AfD and Schwesig support, this should be much harder

if ((Q.union_relation >= 55 && Q.schwesig_votes >= Q.hindenburg_votes) || (Q.union_relation > 35 && Q.union_party_leader == "Wüst")) {
    Q.union_support_schwesig = 1;
    if (Q.hitler_support_hindenburg) {
        Q.hindenburg_to_schwesig_bonus += Q.other_normalized/2;
    }
} else if (Q.union_relation >= 50 && Q.hitler_support_hindenburg) {
    Q.union_support_schwesig = 1;
    Q.hindenburg_to_schwesig_bonus += Q.other_normalized/2;
} else if (Q.union_relation <= 35 || (Q.union_relation <= 45 && Q.schwesig_votes < Q.hindenburg_votes && Q.hindenburg_votes > Q.hitler_votes && Q.difficulty >= 0)) {
    Q.union_support_schwesig = 0;
} else {
    Q.union_support_schwesig = 2;
}
!}
go-to: r2_union_failed if union_support_schwesig = 0 or (union_support_schwesig = 2 and historical_mode); r2_union_success if union_support_schwesig = 1; r2_union_partial if union_support_schwesig = 2 and not historical_mode
max-visits: 1

