@post_election
on-arrival: {!
Q.schwesig_votes = 0;
Q.hindenburg_votes = 0;
Q.hitler_votes = 0;
Q.thalmann_votes = 0;

// initial phase:
Q.hitler_votes += Q.afd_normalized;
Q.hindenburg_votes += Q.other_normalized;
Q.hindenburg_votes += Q.bsw_normalized;

if (Q.schwesig_campaign) {
    Q.schwesig_votes += Q.spd_normalized;
    Q.schwesig_votes += Q.gruene_normalized;
    if (Q.union_support_schwesig && Q.union_support_schwesig == 1) {
        Q.schwesig_votes += Q.union_normalized;
    } else {
        Q.hindenburg_votes += Q.union_normalized;
    }
    if (Q.linke_support_schwesig) {
        Q.schwesig_votes += Q.linke_normalized;
        if (Q.sapd_formed && Q.sapd_votes) {
            Q.schwesig_votes += Q.sapd_normalized;
        }
    } else {
        Q.thalmann_votes += Q.linke_normalized;
        if (Q.sapd_formed && Q.sapd_votes) {
            Q.thalmann_votes += Q.sapd_normalized;
        }
    }
    if (Q.fdp_support_schwesig) {
        Q.schwesig_votes += Q.fdp_normalized;
    } else {
        Q.hindenburg_votes += Q.fdp_normalized;
    }
} else if (Q.spd_support_thalmann) {
    Q.thalmann_votes += Q.linke_normalized;
    Q.thalmann_votes += Q.spd_normalized;
    Q.hindenburg_votes += Q.union_normalized;
    Q.hindenburg_votes += Q.gruene_normalized;
    Q.hindenburg_votes += Q.fdp_normalized;
} else {
    Q.hindenburg_votes += Q.spd_normalized;
    Q.hindenburg_votes += Q.union_normalized;
    Q.hindenburg_votes += Q.gruene_normalized;
    Q.hindenburg_votes += Q.fdp_normalized;
    Q.thalmann_votes += Q.linke_normalized;
}
if (Q.hitler_support_hindenburg) {
    Q.hitler_votes -= Q.afd_normalized;
    Q.hindenburg_votes += Q.afd_normalized;
}

if (Q.hindenburg_to_schwesig_bonus) {
    Q.hindenburg_votes -= Q.hindenburg_to_schwesig_bonus;
    Q.schwesig_votes += Q.hindenburg_to_schwesig_bonus;
}
if (Q.thalmann_to_schwesig_bonus) {
    Q.thalmann_votes -= Q.thalmann_to_schwesig_bonus;
    Q.schwesig_votes += Q.thalmann_to_schwesig_bonus;
}

// check for majority
Q.hindenburg_votes = Math.round(Q.hindenburg_votes*1000)/10;
Q.schwesig_votes = Math.round(Q.schwesig_votes*1000)/10;
Q.hitler_votes = Math.round(Q.hitler_votes*1000)/10;
Q.thalmann_votes = Math.round(Q.thalmann_votes*1000)/10;

Q.hindenburg_majority = (Q.hindenburg_votes >= 50);
Q.thalmann_majority = (Q.thalmann_votes >= 50);
Q.hitler_majority = (Q.hitler_votes >= 50);
Q.schwesig_majority = (Q.schwesig_votes >= 50);
Q.any_majority = Q.hindenburg_majority | Q.thalmann_majority | Q.hitler_majority | Q.schwesig_majority;

// check for plurality
Q.hindenburg_plurality = (Q.hindenburg_votes >= Q.hitler_votes && Q.hindenburg_votes >= Q.schwesig_votes && Q.hindenburg_votes >= Q.thalmann_votes);
Q.thalmann_plurality = (Q.thalmann_votes >= Q.hindenburg_votes && Q.thalmann_votes >= Q.schwesig_votes && Q.thalmann_votes >= Q.hitler_votes);
Q.hitler_plurality = (Q.hitler_votes >= Q.hindenburg_votes && Q.hitler_votes >= Q.schwesig_votes && Q.hitler_votes >= Q.thalmann_votes);
Q.schwesig_plurality = (Q.schwesig_votes >= Q.hindenburg_votes && Q.schwesig_votes >= Q.hitler_votes && Q.schwesig_votes >= Q.thalmann_votes);
// If no candidate gets above 50%, then there's a second round. In the second round, a plurality wins. 
Q.election_round += 1;

// making the vote numbers nicer for the display
Q.hindenburg_votes_disp = Q.hindenburg_votes.toFixed(1).replace('.', ',');
Q.schwesig_votes_disp = Q.schwesig_votes.toFixed(1).replace('.', ',');
Q.hitler_votes_disp = Q.hitler_votes.toFixed(1).replace('.', ',');
Q.thalmann_votes_disp = Q.thalmann_votes.toFixed(1).replace('.', ',');
!}
go-to: hindenburg_wins if hindenburg_majority == 1; thalmann_wins if thalmann_majority == 1; hitler_wins if hitler_majority == 1; schwesig_wins if schwesig_majority == 1; no_majority_round1 if any_majority == 0 and election_round == 1; round2_results if election_round >= 2

Ergebnis:

Lammert – [+ hindenburg_votes_disp +] %

[+ afd_candidate +] – [+ hitler_votes_disp +] %

[? if linke_support_schwesig == 0 : Trabert – [+ thalmann_votes_disp +] % ?]

[? if schwesig_campaign > 0 : Schwesig – [+ schwesig_votes_disp +] % ?]

@no_majority_round1
on-arrival: hitler_support_hindenburg = 1 if (schwesig_plurality or thalmann_plurality)
go-to: round2_menu

Auch im zweiten Wahlgang erreicht niemand die absolute Mehrheit. Im dritten Wahlgang genügt die einfache Mehrheit. Was tun wir?

[? if schwesig_plurality or thalmann_plurality : Um eine linke Präsidentschaft zu verhindern, zieht die AfD [+ afd_candidate +] zurück und ruft ihre Delegierten auf, Lammert zu wählen. ?]


