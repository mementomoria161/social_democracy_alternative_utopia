title: Staatskrise
audio: music/communist/A_las_barricadas.ogg
on-arrival: {!
Q.demo_strength = Math.round(Q.demo_strength);
Q.bauern_strength = Math.round(Q.bauern_strength);
Q.rechts_strength = Math.round(Q.rechts_strength);
// re-calculate dissent, in case we transitioned from, say, the KPD support that raised reformist dissent.
var total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.neorevisionist_strength;
var total_dissent = Q.left_strength*Q.left_dissent + Q.center_strength*Q.center_dissent + Q.labor_strength*Q.labor_dissent + Q.reformist_strength*Q.reformist_dissent + Q.neorevisionist_strength*Q.neorevisionist_dissent;

Q.dissent = 0.01*total_dissent/total_strength;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

Q.civil_war_seen = 1;

// our allies
Q.total_power = 0;
// TODO:  lower reichsbanner strength if the party's popularity is very low.
Q.demo_power = Q.demo_strength*Q.demo_radicalism;
if (Q.dissent > 0.15) {
    Q.demo_power *= (1 - Q.dissent/1.5);
}
Q.total_power += Q.demo_power;
Q.prussian_police_power = Q.prussian_police_strength*Q.prussian_police_radicalism*Q.prussian_police_loyalty;
if (Q.spd_prussia) {
    Q.total_power += Q.prussian_police_power;
}
if (Q.bundeswehr_loyalty < 0) {
    Q.bundeswehr_loyalty = 0;
}
Q.loyal_bundeswehr_power = Q.bundeswehr_strength*Q.bundeswehr_radicalism*Q.bundeswehr_loyalty;
if (Q.spd_in_government && Q.chancellor_party == "SPD") {
    Q.total_power += Q.loyal_bundeswehr_power;
} else {
    Q.total_power += Q.loyal_bundeswehr_power/4;
}
Q.klima_power = Q.klima_strength*Q.klima_radicalism;
if (Q.linke_relation >= 60) {
    Q.total_power += Q.klima_power;
} else if (Q.linke_relation >= 45) {
    Q.total_power += Q.klima_power*0.5;
}
// general strike strength
// maximum (given 25 labor strength) is 400
// use normalized workers_spd instead of labor_strength?
Q.normalized_workers_spd = 100*Q.workers_spd/(Q.workers_spd + Q.workers_linke + Q.workers_afd + Q.workers_other + Q.workers_bsw + Q.workers_union);
Q.normalized_workers_linke = 100*Q.workers_linke/(Q.workers_spd + Q.workers_linke + Q.workers_afd + Q.workers_other + Q.workers_bsw + Q.workers_union);
Q.normalized_workers_total = Q.normalized_workers_spd;
if (Q.linke_relation >= 60) {
    Q.normalized_workers_total += Q.normalized_workers_linke;
} else if (Q.linke_relation >= 45) {
    Q.normalized_workers_total += Q.normalized_workers_linke*0.5;
}
Q.total_power += (2 - Q.labor_dissent/100)*Q.normalized_workers_total*(2 - Q.unemployed/100)*2.5;
console.log("Supporter strength:", Q.total_power);

// our enemies
Q.enemy_power = 0;
Q.rechts_power = Q.rechts_strength*Q.rechts_radicalism;
Q.enemy_power += Q.rechts_power;
Q.bauern_power = Q.bauern_strength*Q.bauern_radicalism;
Q.enemy_power += Q.bauern_power;
Q.hostile_bundeswehr_power = Q.bundeswehr_strength*Q.bundeswehr_radicalism*(1-Q.bundeswehr_loyalty);
Q.enemy_power += Q.hostile_bundeswehr_power;
console.log("Enemy strength:", Q.enemy_power);

if (Q.total_power > Q.enemy_power*1.1) {
    Q.republic_victory = 1;
} else if (Q.total_power/Q.enemy_power >= 0.6) {
    Q.long_war = 1;
} else {
    Q.total_defeat = 1;
}

Q.is_favorable = 0;
if (Q.total_power >= Q.enemy_power*0.95) {
    Q.is_favorable = 1;
}
!}
go-to: war_menu

= Die Kräfteverhältnisse

# Staatskrise statt Bürgerkrieg: Die Stärken sind Teilnehmende (in Tausend), keine Truppen.

Gegen uns stehen radikalisierte Teile der Bauern- und Mittelstandsproteste mit [+ bauern_strength +] Tausend Anhängern und die rechte Straßenmobilisierung mit [+ rechts_strength +] Tausend, darunter bewaffnete Reichsbürger-Gruppen. Wem die [+ bundeswehr_strength +] Tausend Soldatinnen und Soldaten der Bundeswehr und die [+ prussian_police_strength +] Tausend Beamtinnen und Beamten der Landespolizeien die Treue halten, ist unklar.

[? if chancellor_party == "Linke" or president == "Trabert" : Die Linke und die Klimabewegung stehen in der ersten Reihe, und wir stehen an ihrer Seite. ?]

Auf unserer Seite steht die Demokratiebewegung mit [+ demo_strength +] Tausend Menschen. [? if dissent > 0.15 and dissent <= 0.25: Der Streit in unserer Partei schwächt sie etwas, manche bleiben zu Hause. ?][? if dissent > 0.25 and dissent < 0.5: Der Streit in unserer Partei schwächt sie, viele bleiben zu Hause. ?][? if dissent >= 0.5: Der Streit in unserer Partei schwächt sie schwer, ein großer Teil bleibt zu Hause. ?]

[? if demo_radicalism < 0.25 : Leider ist die Bewegung kaum organisiert; gegen entschlossene Blockaden und Einschüchterung wird sie es schwer haben. ?][? if demo_radicalism >= 0.25 and demo_radicalism < 0.5 : Wir haben in Organisation, Ordnerdienste und Netzwerke der Bewegung investiert. Hoffen wir, dass die Menschen durchhalten. ?][? if demo_radicalism >= 0.5 : Wir haben viel in die Bewegung investiert: Bündnisse in jeder Stadt, geschulte Ordner, Telefonketten. Hoffen wir, dass es reicht. ?]

Worauf können wir noch zählen?

# Viele Wege führen in die Staatskrise. Hier werden die Kräfteverhältnisse und mögliche Ausgänge berechnet.

@war_menu

- @rw_help: Die Bundeswehr auf die Verfassung verpflichten.
- @linke_help: Die Linke um Unterstützung bitten.
- @general_strike: Zum Generalstreik aufrufen!
- @loyal_police: Die verfassungstreuen Teile der Polizei einsetzen.
- @war_outcome: Jetzt entscheidet es sich …

@rw_help
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1

Wir appellieren an die Bundeswehr, ihren Eid auf das Grundgesetz zu halten und sich nicht gegen die gewählte Regierung stellen zu lassen. [? if bundeswehr_loyalty < 0.2 : Leider hören nur wenige auf uns; in Teilen der Truppe verachtet man uns. ?][? if bundeswehr_loyalty >= 0.2 and bundeswehr_loyalty < 0.4 : Einige Offiziere und Einheiten folgen unserem Aufruf, manche stellen sich offen auf unsere Seite. ?][? if bundeswehr_loyalty >= 0.4 and bundeswehr_loyalty < 0.6 : Die Bundeswehr ist gespalten. Viele halten sich heraus oder stellen sich auf unsere Seite. ?][? if bundeswehr_loyalty >= 0.6 : Die große Mehrheit der Bundeswehr steht zur Verfassung! Unsere Reformen haben sich ausgezahlt. ?]

@linke_help
max-visits: 1
view-if: chancellor_party != "Linke" and president != "Trabert"
go-to: war_menu
on-arrival: war_choices += 1

Die Klimabewegung zählt [+ klima_strength +] Tausend Aktive, dazu kommen die Beschäftigten, die der Linken nahestehen.

[? if linke_relation >= 60 : Dank unserer guten Beziehungen steht die Linke geschlossen an unserer Seite. ?][? if linke_relation < 60 and linke_relation >= 45 : Der größte Teil der Linken steht an unserer Seite. ?][? if linke_relation < 45 : Die Linke unterstützt uns nicht. ?]

@general_strike
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1

Ein Generalstreik hat 1920 den Kapp-Putsch gestoppt, und er kann auch heute die Feinde der Demokratie stoppen. [? if normalized_workers_total > 70 : Die Beschäftigten stehen weitgehend geschlossen hinter uns. ?][? if normalized_workers_total >= 50 and normalized_workers_total <= 70 : In den Belegschaften gibt es Zweifel, doch eine Mehrheit folgt dem Streikaufruf. ?][? if normalized_workers_total > 30 and normalized_workers_total < 50 : In den Belegschaften gibt es viel Widerspruch, weniger als die Hälfte folgt dem Streikaufruf. ?][? if normalized_workers_total <= 30 : Die Beschäftigten sind tief gespalten, und die meisten folgen dem Streikaufruf nicht. ?]


@loyal_police
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1
view-if: spd_prussia = 1

In den SPD-geführten Ländern können wir die Landespolizeien einsetzen. [? if prussian_police_loyalty < 0.4 : Leider ist auf die Polizei bestenfalls bedingt Verlass. ?][? if prussian_police_loyalty >= 0.4 and prussian_police_loyalty < 0.65 : In dieser entscheidenden Stunde ist die Polizei gespalten, etwa die Hälfte unterstützt uns aktiv. ?][? if prussian_police_loyalty >= 0.65 : Die meisten Beamtinnen und Beamten stehen zur Verfassung. Unsere Arbeit für eine verfassungstreue Polizei zahlt sich aus. ?]




@foreign_intervention
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1;

# Hinweis: wird derzeit nicht verwendet.


@war_outcome
view-if: war_choices >= 2
go-to: defeat if total_defeat = 1; long_war if long_war = 1; republic_victory if republic_victory = 1

@defeat

= Die Demokratie fällt

Wir sind den Kräften des Umsturzes nicht gewachsen. Die Demonstrationen werden auseinandergetrieben, Teile von Polizei und Bundeswehr laufen über, Sender und Ministerien werden besetzt. Eine „Notstandsregierung“ setzt die Verfassung außer Kraft. Viele von uns werden festgenommen, andere fliehen ins Ausland.

Unser Widerstand wird in die Geschichtsbücher eingehen, und eines Tages wird man unsere Namen ehren. Doch für jetzt ist alles verloren.

- @game_over: Spielende.

@long_war
go-to: long_war_intervention if resist_coup == 0; game_over_menu if resist_coup == 1

= Lähmung

Die ersten Tage der Krise sind vorbei, und keine Seite hat sich durchgesetzt.

Das Land ist gespalten. In manchen Regionen herrschen faktisch die Umstürzler, Behörden und Gerichte arbeiten gegeneinander, der Ausnahmezustand wird zum Dauerzustand. Die Republik zerreibt sich, bevor sie neu aufgebaut werden kann.

@game_over_menu

Wir könnten um internationale Hilfe bitten, doch die Partner sehen die Krise als innere Angelegenheit Deutschlands.

- @game_over

# keine Hilfe

@long_war_intervention

- @west_aid: Vielleicht helfen uns die EU und Frankreich.
- @soviet_aid: Vielleicht hilft uns die internationale Gewerkschaftsbewegung.
- @east_aid: Vielleicht helfen uns Polen und die baltischen Staaten. Sie wissen genau, was ein autoritäres Deutschland für sie bedeuten würde.
- @game_over: Spielende.

@west_aid
choose-if: west_relation >= 2
unavailable-subtitle: Unsere Beziehungen sind nicht gut genug.
on-arrival: west_aid += 1
max-visits: 1
go-to: long_war_intervention

Wir bitten Brüssel und Paris um Hilfe. Die EU leitet ein Verfahren nach Artikel 7 gegen die Umstürzler ein, und Frankreich bietet Unterstützung an, doch die Mitgliedstaaten sind uneins. Bis zu einer Entscheidung müssen wir allein durchhalten.

@soviet_aid
choose-if: (soviet_relation >= 1 and linke_relation >= 50) or (linke_relation >= 75)
on-arrival: soviet_aid += 1
unavailable-subtitle: Unsere Beziehungen sind nicht gut genug.
max-visits: 1
go-to: long_war_intervention

Wir rufen die internationalen Gewerkschaften und linken Parteien um Hilfe. Streikkassen, Juristinnen und Juristen und Freiwillige kommen ins Land, doch die meisten Mittel fließen an Linke und Klimabewegung, nicht an uns. Wenn wir gewinnen, verheißt das nichts Gutes für unsere Rolle danach.

@east_aid
choose-if: east_relation >= 2
on-arrival: east_aid += 1
unavailable-subtitle: Unsere Beziehungen sind nicht gut genug.
max-visits: 1
go-to: long_war_intervention

Polen und die baltischen Staaten haben mit eigenen Sorgen zu kämpfen, doch sie schließen die Grenzen für Unterstützer der Umstürzler und lassen Hilfe für die verfassungstreuen Kräfte durch.

@republic_victory

= Sieg für die Demokratie

Die Demokratie hält stand. Die Belagerungen brechen zusammen, die Rädelsführer werden festgenommen, und die Einheiten, die sich den Umstürzlern angeschlossen hatten, geben auf. Heute haben die Verteidigerinnen und Verteidiger der Verfassung gesiegt. Hoffen wir, dass dieser Sieg einen längeren Frieden bringt als manche Siege zuvor.

- @game_over: Spielende.
