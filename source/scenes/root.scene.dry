@start
on-arrival: {!
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
Q.year = 2026;
Q.month = 1;
// how many actions have been taken this month?
Q.month_actions = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
// old demographics
Q.old_demographics = 0;
// use decimals for bundestag seats
// TODO: not yet implemented
Q.use_decimals = 0;
Q.annual_income = 0;
Q.saves_disabled = 0;
Q.discard_disabled = 0;
Q.hand_size = 3;
Q.starting_dissent = 1; // default dissent = normal
Q.starting_relations = 1;
Q.shuffle_leadership_enabled = 0;
Q.cabinet_enabled = 0;

// legacy from the Weimar version (president dismissing the government). The Bundespräsident cannot do this.
Q.hindenburg_enabled = 0;

// party resources
Q.starting_resources = 2;
Q.resources = 2;
// party dues - fundraising income
Q.starting_dues = 2;
Q.dues = 2;

// the state of the party
// overall dissent reduces every increase in party support.
Q.dissent = 0.08;
Q.dissent_percent = 8;

// factions
// left = SPD-Linke (PL, Jusos, DL21); center = Parteimitte/Netzwerk; labor = Gewerkschaftsflügel;
// reformist = Seeheimer Kreis; neorevisionist = "Dänischer Kurs" (hidden at start)
Q.factions = ['left', 'center', 'labor', 'reformist', 'neorevisionist'];
Q.left_strength = 25;
Q.left_dissent = 20;
Q.center_strength = 27;
Q.center_dissent = 0;
Q.labor_strength = 20;
Q.labor_dissent = 10;
Q.reformist_strength = 23;
Q.reformist_dissent = 5;
Q.neorevisionist_strength = 5;
Q.neorevisionist_dissent = 10;

// secret events...
Q.unions_independent = 0;
Q.centrists_resign = 0;
Q.left_split = 0;
Q.reformists_resigned = 0;

// have we discovered the "Dänischer Kurs" faction?
Q.neorevisionism = 0;

// crisis_urgency: how seriously the SPD takes the economic/industrial crisis - scale from 0 to 10.
Q.crisis_urgency = 1;
// the industrial crisis is already underway in 2026 (legacy name from the Weimar version: Black Thursday)
Q.black_thursday_seen = 1;
// nazi_urgency: how seriously the SPD takes the threat from the AfD - scale from 0 to 10.
Q.nazi_urgency = 2;
// radicalization indicates how radical the SPD's rhetoric is - scale from 0 to 10.
Q.radicalization = 0;
// Support for an investment offensive (Investitionsoffensive) - successor of the WTB plan
Q.wtb_support = 0;
// Support for a peace-oriented foreign policy within the SPD relative to 2026
Q.pacifism = 0;
// Support for democratic reform within the SPD relative to 2026
Q.democratization = 0;
// Support for a coalition with Die Linke relative to 2026
Q.communist_coalition = 0;
// economic_plan: have we adopted *any* economic plan?
// 1 - Investitionsoffensive, 2 - Gewerkschaftsplan (Industriepolitik), 3 - radical plan (Vergesellschaftung)
Q.economic_plan = 0;
Q.wtb_adopted = 0;
// have we formed the "Bündnis für Demokratie" (successor of the Iron Front)?
Q.iron_front_formed = 0;
// Volkspartei support
Q.peoples_party_support = 0;
// support for Vergesellschaftung (nationalizations)
Q.nationalization_support = 0;
Q.nationalization_adopted = 0;
// moderate economic plan
Q.moderate_plan_support = 0;
Q.moderate_plan_adopted = 0;

// inter-party relations
Q.union_relation = 45;
Q.linke_relation = 25;
Q.gruene_relation = 45;
Q.fdp_relation = 25;
// BSW and AfD are hostile
Q.bsw_relation = 10;
Q.afd_relation = 0;

// party leaders; the *_party_leader values change the parties' behavior towards the SPD.
// Linke: "Schwerdtner" (default), "Reformer" (friendlier, government-oriented)
Q.linke_leader = "Reichinnek";
Q.linke_party_leader = "Schwerdtner";
// Union: "Merz" (default), "Wüst" (friendlier, centrist), "Spahn" (opens up to the AfD)
Q.union_leader = "Merz";
Q.union_party_leader = "Merz";
Q.afd_leader = "Weidel";

// relationship with the Bundespräsident
Q.hindenburg_relation = 60;
Q.hindenburg_dissent = 0;

// Does the SPD lead strong state governments (Länder / Bundesrat)?
// legacy name from the Weimar version (Prussia).
Q.spd_prussia = 1;
Q.prussian_government = "SPD";

// Protest movements (replacing the Weimar paramilitaries)
// strength = mobilization potential (thousands of people), radicalism = radicalization (0-1+)
// demo = Demokratiebewegung (Demos gegen Rechts, Omas gegen Rechts) - close to SPD/Grüne
Q.starting_demo_strength = 1500;
Q.demo_strength = 1500;
Q.demo_radicalism = 0.01;
Q.women_in_demo = 0;
Q.demo_banned = 0;
// bauern = Bauern- und Mittelstandsproteste - close to Union/BSW/AfD
Q.bauern_strength = 100;
Q.bauern_radicalism = 0.4;
Q.bauern_banned = 0;
Q.bauern_banned_prussia = 0;
// rechts = rechte Straßenmobilisierung - close to the AfD
Q.rechts_strength = 60;
Q.rechts_radicalism = 0.6;
Q.rechts_banned = 0;
Q.rechts_banned_prussia = 0;
// klima = Klimabewegung (Fridays for Future, Letzte Generation) - close to Grüne/Linke
Q.klima_strength = 300;
Q.klima_radicalism = 0.3;
Q.klima_banned = 0;
Q.klima_banned_prussia = 0;

// state institutions: Bundespolizei/Verfassungsschutz (interior), Landespolizeien (prussian), Bundeswehr
// loyalty = Verfassungstreue
Q.interior_police_strength = 55;
Q.interior_police_radicalism = 1;
Q.interior_police_loyalty = 0.75;

Q.prussian_police_strength = 270;
Q.prussian_police_radicalism = 1;
Q.prussian_police_loyalty = 0.8;

Q.bundeswehr_strength = 182;
Q.bundeswehr_radicalism = 1;
Q.bundeswehr_loyalty = 0.8;

// The state of the country

// popular opinion
// nationalism: Abschottung/Nationalismus vs Offenheit/Europa
Q.nationalism = 55;
// socialism: Umverteilung vs Markt
Q.socialism = 45;
// pro_republic: Vertrauen in die Demokratie (support for the democratic parties)
Q.pro_republic = 60;

Q.emergency_rule = 0;

// constitutional reform level
Q.constitutional_reform = 0;
// constructive vote of no confidence - part of the Grundgesetz
Q.constructive_vonc = 1;
Q.voting_age_16 = 0;
Q.kinderrechte_gg = 0;
Q.volksentscheide = 0;
// reduction in presidential powers - the Bundespräsident is largely ceremonial
Q.presidential_powers = 3;
// allows banning of anti-constitutional parties (Art. 21 GG)
Q.constitutional_protection = 1;
Q.linke_banned = 0;
Q.afd_banned = 0;

// coup_progress: pressure towards a Staatskrise (right-wing networks, Reichsbürger);
// capital_strike_progress: Kapitalflucht/Investitionsstreik by business.
// when one reaches 10, a special event is triggered.
Q.coup_progress = 0;
Q.capital_strike_progress = 0;

Q.starting_budget = 4;
Q.budget = 4;

// Proportion of the different voter groups (they overlap; the results are normalized)
Q.workers = 30; // Arbeitnehmer*innen ohne Hochschulabschluss
Q.old_middle = 8; // Selbstständige & Mittelstand
Q.new_middle = 22; // akademische Mittelschicht
Q.rural = 16; // ländlicher Raum
// unemployment rate (Bundesagentur für Arbeit, Januar 2026: ca. 6,3 %) - doubles as the size of the group
Q.unemployed = 6.3;
Q.rentner = 32; // Rentner*innen

// average gross income in euros/month (Destatis 2025, Vollzeit)
Q.income = 4600;

// inflation (Verbraucherpreisindex, Ende 2025: ca. 2 %)
Q.inflation = 2.1;

