// economic growth (Destatis, BIP 2024: -0,2 % in der ersten Schätzung vom Januar 2025, später auf -0,5 % revidiert)
Q.economic_growth = -0.2;
// Trendwachstum, zu dem die Konjunktur ab Dezember 2026 zurückkehrt (post_event, erklärt in der Bibliothek)
