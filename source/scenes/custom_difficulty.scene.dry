title: Eigene Schwierigkeit
on-departure: {!
Q.difficulty = 2;
// TODO: use js to get all the things
Q.starting_resources = Number.parseInt(document.getElementById("resources").value);
Q.resources = Q.starting_resources;

Q.starting_dues = Number.parseInt(document.getElementById("fundraising_income").value);
Q.dues = Q.starting_dues;

Q.annual_income = Number.parseInt(document.getElementById("annual_income").value);
Q.starting_budget = Number.parseInt(document.getElementById("budget").value);
Q.budget = Q.starting_budget;

Q.starting_dissent = Number.parseInt(document.getElementById("starting_dissent").value); 
if (Q.starting_dissent == 0) {
    Q.left_dissent = 10;
    Q.center_dissent = 0;
    Q.labor_dissent = 5;
    Q.reformist_dissent = 5;
} else if (Q.starting_dissent == 1) {
    Q.left_dissent = 20;
    Q.center_dissent = 0;
    Q.labor_dissent = 5;
    Q.reformist_dissent = 5;
} else {
    Q.left_dissent = 30;
    Q.center_dissent = 20;
    Q.labor_dissent = 25;
    Q.reformist_dissent = 25;
}

Q.starting_relations = Number.parseInt(document.getElementById("starting_relations").value); 
if (Q.starting_relations == 0) {
    Q.linke_relation = 29;
    Q.union_relation = 54;
    Q.fdp_relation = 49;
} else if (Q.starting_relations == 1) {
    Q.linke_relation = 25;
    Q.union_relation = 50;
    Q.fdp_relation = 35;
} else {
    Q.linke_relation = 16;
    Q.union_relation = 41;
    Q.fdp_relation = 31;
}

Q.starting_demo_strength = Number.parseInt(document.getElementById("starting_demo_strength").value);
Q.demo_strength = Q.starting_demo_strength;

Q.hand_size = Number.parseInt(document.getElementById("hand_size").value);

Q.historical_mode = Number.parseInt(document.getElementById("historical_mode").value);

Q.discard_disabled = Number.parseInt(document.getElementById("discard_disabled").value);

Q.saves_disabled = Number.parseInt(document.getElementById("saves_disabled").value);

Q.cabinet_enabled = Number.parseInt(document.getElementById("cabinet_enabled").value);

Q.shuffle_leadership_enabled = Number.parseInt(document.getElementById("shuffle_leadership_enabled").value);

if (Q.saves_disabled) {
    this.state.disableSaves = true;
}

if (Q.historical_mode && Q.annual_income == 0) {
    alert("Im historischen Modus muss das jährliche Einkommen größer als 0 sein – es wird auf 1 gesetzt.");
    Q.annual_income = 1;
}
!}

= Schwierigkeitseinstellungen

# difficulty settings:
# 1. Einnahmen aus Spenden:
# 2. Annual income:
# 3. Initial dissent:
# 4. Initial inter-party relations:
# 5. Hindenburg removal enabled:
# 6. Initial Hindenburg relations:
# 7. WTB difficulty:
# 8. Enable saving/loading:
# 9. Initial budget

Ressourcen der Partei zu Beginn: {! <input type="number" id="resources" name="resources" value="2" min="0" max="10"></input> !}

# default: 2
Einnahmen aus Spenden: {! <input type="number" id="fundraising_income" name="fundraising_income" value="2" min="0" max="5"></input> !}

# default: 0
Jährliches Einkommen der Partei: {! <input type="number" id="annual_income" name="annual_income" value="0" min="0" max="5"></input>!}

# default: 4
Haushaltsspielraum zu Beginn: {! <input type="number" id="budget" name="budget" min="0" max="10" value="4"></input>!}

# default: 1 (normal)
Unmut in der Partei zu Beginn: {! <select name="starting_dissent" id="starting_dissent"> 
<option value="0">Leicht</option>
<option value="1" selected>Normal</option>
<option value="2">Schwer</option>
</select> !}


# default: 1 (normal)
Beziehungen zu anderen Parteien zu Beginn: {! <select name="starting_relations" id="starting_relations"> 
<option value="0">Leicht</option>
<option value="1" selected>Normal</option>
<option value="2">Schwer</option>
</select> !}

# default: 1 (normal)
Stärke der Demokratiebewegung zu Beginn (Tausend): {! <select name="starting_demo_strength" id="starting_demo_strength"> 
<option value="1000">1000</option>
<option value="1500" selected>1500</option>
<option value="2000">2000</option>
</select> !}



# historical mode
Historischer Modus (orientiert sich am realen Verlauf, erschwert manche Aktionen): {! <select name="historical_mode" id="historical_mode"> 
<option value="0" selected>Aus</option>
<option value="1">An</option>
</select> !}

# default: disabled
#Hindenburg removing the government: {! <select name="hindenburg_enabled" id="hindenburg_enabled"> <option value="0" selected>Aus</option> <option value="1">An</option> </select> !}

# Shuffle leadership card: disabled 
Dauerkarte „Führung umbilden“: {! <select name="shuffle_leadership_enabled" id="shuffle_leadership_enabled"> 
<option value="0" selected>Aus</option>
<option value="1">An</option>
</select> !}

# cabinet card:
Dauerkarte „Kabinett“: {! <select name="cabinet_enabled" id="cabinet_enabled"> 
<option value="0" selected>Aus</option>
<option value="1">An</option>
</select> !}

# default: enabled
Speichern/Laden: {! <select name="saves_disabled" id="saves_disabled"> 
<option value="1">Aus</option>
<option value="0" selected>An</option>
</select> !}

# default: 1 (normal)
Kartenhand: {! <select name="hand_size" id="hand_size"> 
<option value="3" selected>3</option>
<option value="4">4</option>
</select> !}

# default: enabled
Karten auf die Hand zurücklegen: {! <select name="discard_disabled" id="discard_disabled"> 
<option value="1">Aus</option>
<option value="0" selected>An</option>
</select> !}

- @done: Fertig

@done
go-to: root.2026_main
